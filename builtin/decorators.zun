// Typed TC39 decorator context. A decorator declared as
// `(value: any, context: DecoratorContext)` receives one of these instead of
// the dynamic `any` context. Function values cannot be stored in `Any`, an
// `any[]`, or a typed class field (the slot does not preserve the callable),
// so `addInitializer` hands the callback straight to a native that queues it on
// the interpreter side; `finish` drains and runs the queue.
//
// The checker lowers each typed runtime decorator to
// `ctx = DecoratorContext.make(..); dec(value, ctx); DecoratorContext.finish(ctx)`
// in the module initializer.
//
// `addInitializer(fn)`:
//   * class decorators (and static members): the callback runs right after the
//     decorator returns, with `null` as its single argument;
//   * instance methods/fields: the callback is registered for the class and runs
//     on every new instance with the instance as its single argument (the
//     `this` of the element). A Function value is invoked with exactly the
//     arguments it declares, so each initializer is `(self: T) => ...`.
//
// `context.access.get(target)` / `.set(target, value)` read and write the
// decorated field of an instance (or, for a method, `get` returns the method
// bound to the instance). The element is addressed by class and slot, never by
// a stored function, so no function value has to live in a typed field.

class DecoratorAccess {
    classRid: number;
    slot: number;
    name: string;

    get(target: any): any {
        return decoratorAccessGet(target, this.classRid, this.slot, this.name);
    }

    set(target: any, value: any): void {
        decoratorAccessSet(target, this.classRid, this.slot, this.name, value);
    }
}

class DecoratorContext {
    kind: string;
    name: string;
    isStatic: boolean;
    classRid: number;
    slot: number;
    access: DecoratorAccess;

    addInitializer(initializer: Function): void {
        if (this.kind == "class" || this.isStatic) {
            decoratorAddInitializer(initializer);
        } else {
            decoratorAddInstanceInitializer(this.classRid, initializer);
        }
    }

    static make(kind: string, name: string, isStatic: boolean, classRid: number, slot: number): DecoratorContext {
        return new DecoratorContext(kind, name, isStatic, classRid, slot, new DecoratorAccess(classRid, slot, name));
    }

    static finish(context: DecoratorContext): void {
        if (context.kind == "class" || context.isStatic) {
            decoratorRunInitializers();
        }
    }
}
