// Declarative realm globals for the Zun base types (PLAN §3.1).
//
// Each line registers a base type onto the realm global as a readonly binding.
// The value identifier (e.g. `Map`) resolves to an opaque class descriptor; the
// registry entry it produces is the single source of truth for how the name
// resolves as a type annotation and how `new <Name>()` lowers, so later a
// program can rebind the surface name (`import Map from "..."`) over the same
// frozen runtime representation.
//
// The compiler recognizes each `global.set("<BaseType>", <BaseType>, true)`
// directive at std-compile time; it is not ordinary executable code (Zun has no
// top-level statements). Each listed base type flows through the declarative
// path (annotation type, descriptor value, and `new` lowering come from the
// realm registry); the remaining types stay on the checker's hardcoded
// resolution until they are listed here too.
//
// `Map` stays first so its descriptor keeps token 0.

// Managed collections and the Promise/registry intrinsics.
global.set("Map", Map, true);
global.set("Set", Set, true);
global.set("WeakMap", WeakMap, true);
global.set("WeakSet", WeakSet, true);
global.set("WeakRef", WeakRef, true);
global.set("FinalizationRegistry", FinalizationRegistry, true);
global.set("Promise", Promise, true);

// Argument-taking intrinsics.
global.set("RegExp", RegExp, true);
global.set("BigInt", BigInt, true);

// Array and the buffer family.
global.set("Array", Array, true);
global.set("ArrayBuffer", ArrayBuffer, true);
global.set("DataView", DataView, true);
global.set("Uint8Array", Uint8Array, true);
global.set("Uint16Array", Uint16Array, true);
global.set("Uint32Array", Uint32Array, true);
global.set("Float64Array", Float64Array, true);
global.set("Int8Array", Int8Array, true);
global.set("Uint8ClampedArray", Uint8ClampedArray, true);
global.set("Int16Array", Int16Array, true);
global.set("Int32Array", Int32Array, true);
global.set("Float32Array", Float32Array, true);
global.set("BigInt64Array", BigInt64Array, true);
global.set("BigUint64Array", BigUint64Array, true);

// Value types and surface-only globals.
global.set("String", String, true);
global.set("Number", Number, true);
global.set("Boolean", Boolean, true);
global.set("Object", Object, true);
global.set("Symbol", Symbol, true);
