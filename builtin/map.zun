// Thin class wrapper over the runtime-owned ordered hash table.
import { map } from "zun:core";

class Map {
    set(key: any, value: any): void { map.set(this, key, value); }
    get(key: any): any { return map.get(this, key); }
    has(key: any): boolean { return map.has(this, key); }
    size(): u64 { return map.size(this); }
    delete(key: any): boolean { return map.delete(this, key); }
    clear(): void { map.clear(this); }
    values(): Array { return map.values(this); }
    keys(): Array { return map.keys(this); }
    entries(): Array { return map.entries(this); }
    // `forEach(callback)` invokes `callback(value, key, map)` in insertion
    // order; it is provided by the `zun:core` `map.forEach` native, which the
    // sema layer routes before class dispatch (as with Array's callbacks). The
    // iterable constructor `new Map([[k, v], ...])` lowers through `mapFrom`.
}
