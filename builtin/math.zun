// Numeric helpers implemented in Zun source.
// Runtime-backed operations remain in the `zun:*` intrinsic modules.

import { math } from "zun:core";


function mathAbs(value: number): number {
    if (value < 0.0) { return -value; }
    return value;
}

function mathClamp(value: number, low: number, high: number): number {
    if (value < low) { return low; }
    if (value > high) { return high; }
    return value;
}

function mathSqrt(value: number): number {
    return math.sqrtNumber(value);
}

function mathCbrt(value: number): number {
    return math.cbrtNumber(value);
}

function mathMin(left: number, right: number): number {
    return math.minNumber(left, right);
}

function mathMax(left: number, right: number): number {
    return math.maxNumber(left, right);
}

function mathFloor(value: number): number {
    return math.floorNumber(value);
}

function mathCeil(value: number): number {
    return math.ceilNumber(value);
}

function mathRound(value: number): number {
    return math.roundNumber(value);
}

function mathPow(base: number, exponent: number): number {
    return math.powNumber(base, exponent);
}

function mathSin(value: number): number {
    return math.sinNumber(value);
}

function mathCos(value: number): number {
    return math.cosNumber(value);
}

function mathExp(value: number): number {
    return math.expNumber(value);
}

function mathLog(value: number): number {
    return math.logNumber(value);
}

function mathLog10(value: number): number {
    return math.log10Number(value);
}

function mathLog2(value: number): number {
    return math.log2Number(value);
}

function mathExpm1(value: number): number {
    return math.expm1Number(value);
}

function mathLog1p(value: number): number {
    return math.log1pNumber(value);
}

function mathSinh(value: number): number {
    return math.sinhNumber(value);
}

function mathCosh(value: number): number {
    return math.coshNumber(value);
}

function mathTanh(value: number): number {
    return math.tanhNumber(value);
}

function mathAsinh(value: number): number {
    return math.asinhNumber(value);
}

function mathAcosh(value: number): number {
    return math.acoshNumber(value);
}

function mathAtanh(value: number): number {
    return math.atanhNumber(value);
}

function mathTan(value: number): number {
    return math.tanNumber(value);
}

function mathAtan2(y: number, x: number): number {
    return math.atan2Number(y, x);
}

function mathHypot(left: number, right: number): number {
    return math.hypotNumber(left, right);
}

function mathSign(value: number): number {
    return math.signNumber(value);
}

function mathTrunc(value: number): number {
    return math.truncNumber(value);
}

