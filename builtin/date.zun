// UTC calendar surface over a millisecond timestamp.
//
// Construction is `new Date(millis)` or `new Date()`. The no-argument form
// falls out of the field default initializer `millis = time.nowMillis()`:
// when `new Date()` supplies no argument, the object is built from the
// initializer (the current time); `new Date(0)` still binds the epoch. This is
// the same trailing-default-initializer mechanism `Error.stackFrames` uses.
// JS also has `new Date(string)`; Zun builds an object from one positional
// argument per field with no overloads, so the string form arrives as the
// `Date.fromISO` static instead.
//
// The calendar is UTC-only: the VM exposes no platform timezone offset, so
// local time *is* UTC. The local-time getters (`getFullYear`, `getHours`, ...)
// therefore return exactly their UTC counterparts and `getTimezoneOffset`
// returns 0. These are accurate for a UTC-only calendar, not stubs; a real
// local offset waits on a timezone intrinsic that does not yet exist.

import { date, time } from "zun:core";

class Date {
    millis: i64 = time.nowMillis();

    setMillis(value: i64): Date {
        this.millis = value;
        return this;
    }

    valueOf(): i64 { return this.millis; }
    isValid(): boolean { return date.isValid(this.millis); }
    getTime(): i64 { return this.millis; }
    setTime(value: i64): i64 {
        this.millis = value;
        return this.millis;
    }
    isBefore(other: Date): boolean { return this.millis < other.millis; }
    isAfter(other: Date): boolean { return this.millis > other.millis; }
    isEqual(other: Date): boolean { return this.millis == other.millis; }

    utcYear(): i32 { return date.year(this.millis); }
    utcMonth(): i32 { return date.month(this.millis); }
    utcDay(): i32 { return date.day(this.millis); }
    utcHour(): i32 { return date.hour(this.millis); }
    utcMinute(): i32 { return date.minute(this.millis); }
    utcSecond(): i32 { return date.second(this.millis); }
    utcMillisecond(): i32 { return date.millisecond(this.millis); }
    utcWeekday(): i32 { return date.weekday(this.millis); }
    utcDayOfYear(): i32 { return date.dayOfYear(this.millis); }
    isoDate(): string { return date.isoDate(this.millis); }
    isoDateTime(): string { return date.isoDateTime(this.millis); }
    // The JS-named getters follow JS conventions, which differ from the
    // calendar accessors above: months are 0-based and the weekday is
    // 0-based from Sunday, where `utcMonth`/`utcWeekday` are 1-based and
    // ISO (1 = Monday). Both used to return the calendar value directly,
    // so `getUTCMonth()` was off by one and `getUTCDay()` gave 7 for the
    // Sunday JS calls 0 — wrong answers rather than missing ones.
    getUTCFullYear(): i32 { return this.utcYear(); }
    getUTCMonth(): i32 { return this.utcMonth() - 1; }
    getUTCDate(): i32 { return this.utcDay(); }
    getUTCHours(): i32 { return this.utcHour(); }
    getUTCMinutes(): i32 { return this.utcMinute(); }
    getUTCSeconds(): i32 { return this.utcSecond(); }
    getUTCMilliseconds(): i32 { return this.utcMillisecond(); }
    getUTCWeekday(): i32 { return this.utcWeekday(); }
    getUTCDay(): i32 { return this.utcWeekday() % 7; }
    getUTCDayOfYear(): i32 { return this.utcDayOfYear(); }

    // UTC-only calendar, so local time is UTC and the offset is always zero.
    // Reporting 0 is accurate here; it is not a stub.
    getTimezoneOffset(): i32 { return 0; }

    // Local-time getters. The VM has no platform timezone, so local == UTC and
    // each delegates to the UTC-named getter (same 0-based month, 0-based-from-
    // Sunday weekday conventions). They become distinct from the UTC getters
    // only once a timezone intrinsic supplies a non-zero `getTimezoneOffset`.
    getFullYear(): i32 { return this.getUTCFullYear(); }
    getMonth(): i32 { return this.getUTCMonth(); }
    getDate(): i32 { return this.getUTCDate(); }
    getDay(): i32 { return this.getUTCDay(); }
    getHours(): i32 { return this.getUTCHours(); }
    getMinutes(): i32 { return this.getUTCMinutes(); }
    getSeconds(): i32 { return this.getUTCSeconds(); }
    getMilliseconds(): i32 { return this.getUTCMilliseconds(); }

    // Setters rebuild the timestamp from the components, replacing one. Each
    // returns the new timestamp, as JS does. Out-of-range values roll over
    // (month 13 is January of the next year), also as JS does.
    setUTCFullYear(value: i32): i64 {
        this.millis = date.fromUTC(value as i64, this.utcMonth() as i64, this.utcDay() as i64, this.utcHour() as i64, this.utcMinute() as i64, this.utcSecond() as i64, this.utcMillisecond() as i64);
        return this.millis;
    }
    setUTCMonth(value: i32): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, (value + 1) as i64, this.utcDay() as i64, this.utcHour() as i64, this.utcMinute() as i64, this.utcSecond() as i64, this.utcMillisecond() as i64);
        return this.millis;
    }
    setUTCDate(value: i32): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, this.utcMonth() as i64, value as i64, this.utcHour() as i64, this.utcMinute() as i64, this.utcSecond() as i64, this.utcMillisecond() as i64);
        return this.millis;
    }
    setUTCHours(value: i32): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, this.utcMonth() as i64, this.utcDay() as i64, value as i64, this.utcMinute() as i64, this.utcSecond() as i64, this.utcMillisecond() as i64);
        return this.millis;
    }
    setUTCMinutes(value: i32): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, this.utcMonth() as i64, this.utcDay() as i64, this.utcHour() as i64, value as i64, this.utcSecond() as i64, this.utcMillisecond() as i64);
        return this.millis;
    }
    setUTCSeconds(value: i32): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, this.utcMonth() as i64, this.utcDay() as i64, this.utcHour() as i64, this.utcMinute() as i64, value as i64, this.utcMillisecond() as i64);
        return this.millis;
    }
    setUTCMilliseconds(value: i32): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, this.utcMonth() as i64, this.utcDay() as i64, this.utcHour() as i64, this.utcMinute() as i64, this.utcSecond() as i64, value as i64);
        return this.millis;
    }
    // Local-time setters. The calendar is UTC-only (local == UTC, matching the
    // local getters above), so each delegates to the same UTC component math as
    // its `setUTC*` counterpart and returns the new timestamp. The optional
    // trailing arguments follow ECMAScript: an omitted component keeps its
    // current value (the default expression reads it back off `this` before the
    // timestamp is rebuilt). `month`/`day` here are the JS-named 0-based month
    // and 1-based date, as `getUTCMonth`/`getUTCDate` report them.
    setFullYear(year: i32, month: i32 = this.getUTCMonth(), day: i32 = this.getUTCDate()): i64 {
        this.millis = date.fromUTC(year as i64, (month + 1) as i64, day as i64, this.utcHour() as i64, this.utcMinute() as i64, this.utcSecond() as i64, this.utcMillisecond() as i64);
        return this.millis;
    }
    setMonth(month: i32, day: i32 = this.getUTCDate()): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, (month + 1) as i64, day as i64, this.utcHour() as i64, this.utcMinute() as i64, this.utcSecond() as i64, this.utcMillisecond() as i64);
        return this.millis;
    }
    setDate(day: i32): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, this.utcMonth() as i64, day as i64, this.utcHour() as i64, this.utcMinute() as i64, this.utcSecond() as i64, this.utcMillisecond() as i64);
        return this.millis;
    }
    setHours(hour: i32, minute: i32 = this.utcMinute(), second: i32 = this.utcSecond(), milli: i32 = this.utcMillisecond()): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, this.utcMonth() as i64, this.utcDay() as i64, hour as i64, minute as i64, second as i64, milli as i64);
        return this.millis;
    }
    setMinutes(minute: i32, second: i32 = this.utcSecond(), milli: i32 = this.utcMillisecond()): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, this.utcMonth() as i64, this.utcDay() as i64, this.utcHour() as i64, minute as i64, second as i64, milli as i64);
        return this.millis;
    }
    setSeconds(second: i32, milli: i32 = this.utcMillisecond()): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, this.utcMonth() as i64, this.utcDay() as i64, this.utcHour() as i64, this.utcMinute() as i64, second as i64, milli as i64);
        return this.millis;
    }
    setMilliseconds(milli: i32): i64 {
        this.millis = date.fromUTC(this.utcYear() as i64, this.utcMonth() as i64, this.utcDay() as i64, this.utcHour() as i64, this.utcMinute() as i64, this.utcSecond() as i64, milli as i64);
        return this.millis;
    }
    // GATED: `toLocaleDateString`/`toLocaleTimeString`/`toLocaleString` need a
    // locale/ICU model the VM does not have; they are intentionally absent.
    toISOString(): string { return this.isoDateTime(); }
    toJSON(): string { return this.toISOString(); }
    toString(): string { return this.isoDateTime(); }

    // JS statics. `now` and `parse` return a timestamp rather than a `Date`,
    // as they do in JS; the object-returning forms are named separately.
    static now(): i64 { return time.nowMillis(); }
    static parse(value: string): i64 { return date.parseIsoDateTime(value); }
    static fromMillis(value: i64): Date { return new Date(value); }
    static fromISO(value: string): Date { return new Date(date.parseIsoDateTime(value)); }
    static fromISODate(value: string): Date { return new Date(date.parseIsoDate(value)); }
    // `Date.UTC(year, month, ...)` takes a 0-based month, as JS does.
    static UTC(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32, milli: i32): i64 {
        return date.fromUTC(year as i64, (month + 1) as i64, day as i64, hour as i64, minute as i64, second as i64, milli as i64);
    }
}
