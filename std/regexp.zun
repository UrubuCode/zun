// Thin class wrapper over the Rust regex engine and managed heap floor.
import { regexpIsMatch, regexpExec, regexpSource } from "zun:collections";

class RegExp {
    isMatch(input: string): boolean { return regexpIsMatch(this, input); }
    test(input: string): boolean { return regexpIsMatch(this, input); }
    exec(input: string): array { return regexpExec(this, input); }
    source(): string { return regexpSource(this); }
}
