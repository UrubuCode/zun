// Thin source wrapper over the GC finalization queue.
import { finalizationRegistry } from "zun:core";

class FinalizationRegistry {
    register(target: any, callback: Function): u64 {
        return finalizationRegistry.finalizationRegister(this, target, callback);
    }

    unregister(id: u64): boolean {
        return finalizationRegistry.finalizationUnregister(this, id);
    }
}
