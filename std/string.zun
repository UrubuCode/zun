// The String surface is a statically bound primitive-backed class.

import { length, contains, charCodeAt, startsWith, endsWith, trim, repeat } from "zun:string";

class String {
    concat(other: string): string {
        return this + other;
    }

    withSeparator(separator: string, other: string): string {
        return this + separator + other;
    }

    isEmpty(): boolean {
        return this.length() == 0;
    }

    toString(): string {
        return this;
    }

    extern length(): u64;
    extern contains(needle: string): boolean;
    extern charCodeAt(index: u64): u32;
    extern startsWith(prefix: string): boolean;
    extern endsWith(suffix: string): boolean;
    extern trim(): string;
    extern repeat(count: u64): string;
}
