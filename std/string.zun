// The String surface is a statically bound primitive-backed class.

import { length, contains, count, compare, toInt, toFloat, toBoolean, includes, indexOf, lastIndexOf, replace, substring, padStart, padEnd, toLowerCase, toUpperCase, charCodeAt, startsWith, endsWith, trim, trimStart, trimEnd, repeat, reverse } from "zun:core";

class String {
    concat(other: string): string {
        return this + other;
    }

    withSeparator(separator: string, other: string): string {
        return this + separator + other;
    }

    isEmpty(): boolean {
        return this.length() == 0;
    }

    isNotEmpty(): boolean {
        return this.length() != 0;
    }

    isAscii(): boolean {
        let index: u64 = 0;
        while (index < this.length()) {
            if (this.charCodeAt(index) > 127) { return false; }
            index = index + 1;
        }
        return true;
    }

    isNumeric(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code < 48) { return false; }
            if (code > 57) { return false; }
            index = index + 1;
        }
        return true;
    }

    isDigit(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code < 48) { return false; }
            if (code > 57) { return false; }
            index = index + 1;
        }
        return true;
    }

    isVowel(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            let vowel: boolean = false;
            if (code == 65) { vowel = true; }
            if (code == 69) { vowel = true; }
            if (code == 73) { vowel = true; }
            if (code == 79) { vowel = true; }
            if (code == 85) { vowel = true; }
            if (code == 97) { vowel = true; }
            if (code == 101) { vowel = true; }
            if (code == 105) { vowel = true; }
            if (code == 111) { vowel = true; }
            if (code == 117) { vowel = true; }
            if (!vowel) { return false; }
            index = index + 1;
        }
        return true;
    }

    isConsonant(): boolean {
        if (!this.isAlpha()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code == 65) { return false; }
            if (code == 69) { return false; }
            if (code == 73) { return false; }
            if (code == 79) { return false; }
            if (code == 85) { return false; }
            if (code == 97) { return false; }
            if (code == 101) { return false; }
            if (code == 105) { return false; }
            if (code == 111) { return false; }
            if (code == 117) { return false; }
            index = index + 1;
        }
        return true;
    }

    isQuoted(): boolean {
        if (this.length() < 2) { return false; }
        let first: u32 = this.charCodeAt(0);
        let last: u32 = this.charCodeAt(this.length() - 1);
        if (first == 34) { return last == 34; }
        if (first == 39) { return last == 39; }
        return false;
    }

    unquote(): string {
        if (!this.isQuoted()) { return this; }
        return this.substring(1, this.length() - 1);
    }

    isWrappedBy(prefix: string, suffix: string): boolean {
        if (!this.startsWith(prefix)) { return false; }
        return this.endsWith(suffix);
    }

    quote(): string {
        return "\"" + this + "\"";
    }

    isWhitespace(): boolean {
        if (this.isEmpty()) { return false; }
        return this.trim().isEmpty();
    }

    isAlpha(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code < 65) { return false; }
            if (code > 90) {
                if (code < 97) { return false; }
                if (code > 122) { return false; }
            }
            index = index + 1;
        }
        return true;
    }

    isAlphanumeric(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code < 48) { return false; }
            if (code > 57) {
                if (code < 65) { return false; }
                if (code > 90) {
                    if (code < 97) { return false; }
                    if (code > 122) { return false; }
                }
            }
            index = index + 1;
        }
        return true;
    }

    isHexadecimal(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code < 48) { return false; }
            if (code > 57) {
                if (code < 65) { return false; }
                if (code > 70) {
                    if (code < 97) { return false; }
                    if (code > 102) { return false; }
                }
            }
            index = index + 1;
        }
        return true;
    }

    isHexDigit(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            let valid: boolean = false;
            if (code >= 48) { if (code <= 57) { valid = true; } }
            if (code >= 65) { if (code <= 70) { valid = true; } }
            if (code >= 97) { if (code <= 102) { valid = true; } }
            if (!valid) { return false; }
            index = index + 1;
        }
        return true;
    }

    isBinary(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code < 48) { return false; }
            if (code > 49) { return false; }
            index = index + 1;
        }
        return true;
    }

    isOctal(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code < 48) { return false; }
            if (code > 55) { return false; }
            index = index + 1;
        }
        return true;
    }

    isPrintable(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code < 32) { return false; }
            if (code > 126) { return false; }
            index = index + 1;
        }
        return true;
    }

    isPunctuation(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            let punctuation: boolean = false;
            if (code >= 33) { if (code <= 47) { punctuation = true; } }
            if (code >= 58) { if (code <= 64) { punctuation = true; } }
            if (code >= 91) { if (code <= 96) { punctuation = true; } }
            if (code >= 123) { if (code <= 126) { punctuation = true; } }
            if (!punctuation) { return false; }
            index = index + 1;
        }
        return true;
    }

    isControl(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code > 31) {
                if (code != 127) { return false; }
            }
            index = index + 1;
        }
        return true;
    }

    isSignedInteger(): boolean {
        if (this.isEmpty()) { return false; }
        let start: u64 = 0;
        let first: u32 = this.charCodeAt(0);
        if (first == 43) { start = 1; }
        if (first == 45) { start = 1; }
        if (start == this.length()) { return false; }
        let index: u64 = start;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code < 48) { return false; }
            if (code > 57) { return false; }
            index = index + 1;
        }
        return true;
    }

    isSignedDecimal(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        let digits: u64 = 0;
        let dots: u64 = 0;
        let first: u32 = this.charCodeAt(0);
        if (first == 43) { index = 1; }
        if (first == 45) { index = 1; }
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code == 46) {
                dots = dots + 1;
                if (dots > 1) { return false; }
            } else {
                if (code < 48) { return false; }
                if (code > 57) { return false; }
                digits = digits + 1;
            }
            index = index + 1;
        }
        return digits > 0;
    }

    isIdentifier(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            let valid: boolean = false;
            if (code == 95) { valid = true; }
            if (code >= 65) {
                if (code <= 90) { valid = true; }
            }
            if (code >= 97) {
                if (code <= 122) { valid = true; }
            }
            if (index > 0) {
                if (code >= 48) {
                    if (code <= 57) { valid = true; }
                }
            }
            if (!valid) { return false; }
            index = index + 1;
        }
        return true;
    }

    isTitleCase(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        let expectUpper: boolean = true;
        let hasLetter: boolean = false;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code == 32) {
                expectUpper = true;
            } else {
                if (expectUpper) {
                    if (code < 65) { return false; }
                    if (code > 90) { return false; }
                    expectUpper = false;
                    hasLetter = true;
                } else {
                    if (code >= 65) {
                        if (code <= 90) { return false; }
                    }
                    if (code < 97) { return false; }
                    if (code > 122) { return false; }
                }
            }
            index = index + 1;
        }
        if (!hasLetter) { return false; }
        return !expectUpper;
    }

    isSnakeCase(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        let previousSeparator: boolean = true;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code == 95) {
                if (previousSeparator) { return false; }
                previousSeparator = true;
            } else {
                if (code >= 97) {
                    if (code > 122) { return false; }
                } else {
                    if (code < 48) { return false; }
                    if (code > 57) { return false; }
                }
                previousSeparator = false;
            }
            index = index + 1;
        }
        return !previousSeparator;
    }

    isKebabCase(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        let previousSeparator: boolean = true;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code == 45) {
                if (previousSeparator) { return false; }
                previousSeparator = true;
            } else {
                if (code >= 97) {
                    if (code > 122) { return false; }
                } else {
                    if (code < 48) { return false; }
                    if (code > 57) { return false; }
                }
                previousSeparator = false;
            }
            index = index + 1;
        }
        return !previousSeparator;
    }

    isCamelCase(): boolean {
        if (this.isEmpty()) { return false; }
        let first: u32 = this.charCodeAt(0);
        if (first < 97) { return false; }
        if (first > 122) { return false; }
        let index: u64 = 1;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            let valid: boolean = false;
            if (code >= 48) { if (code <= 57) { valid = true; } }
            if (code >= 65) { if (code <= 90) { valid = true; } }
            if (code >= 97) { if (code <= 122) { valid = true; } }
            if (!valid) { return false; }
            index = index + 1;
        }
        return true;
    }

    isPascalCase(): boolean {
        if (this.isEmpty()) { return false; }
        let first: u32 = this.charCodeAt(0);
        if (first < 65) { return false; }
        if (first > 90) { return false; }
        let index: u64 = 1;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            let valid: boolean = false;
            if (code >= 48) { if (code <= 57) { valid = true; } }
            if (code >= 65) { if (code <= 90) { valid = true; } }
            if (code >= 97) { if (code <= 122) { valid = true; } }
            if (!valid) { return false; }
            index = index + 1;
        }
        return true;
    }

    isLowerCase(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        let hasLetter: boolean = false;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code >= 65) {
                if (code <= 90) { return false; }
                if (code >= 97) {
                    if (code <= 122) { hasLetter = true; }
                }
            }
            index = index + 1;
        }
        return hasLetter;
    }

    isUpperCase(): boolean {
        if (this.isEmpty()) { return false; }
        let index: u64 = 0;
        let hasLetter: boolean = false;
        while (index < this.length()) {
            let code: u32 = this.charCodeAt(index);
            if (code >= 97) {
                if (code <= 122) { return false; }
            }
            if (code >= 65) {
                if (code <= 90) { hasLetter = true; }
            }
            index = index + 1;
        }
        return hasLetter;
    }

    toString(): string {
        return this;
    }

    isBlank(): boolean {
        return this.trim().isEmpty();
    }

    isPalindrome(): boolean {
        return this == this.reverse();
    }

    extern length(): u64;
    extern contains(needle: string): boolean;
    extern count(needle: string): int;
    extern compare(other: string): int;
    extern toInt(): int;
    extern toFloat(): number;
    extern toBoolean(): boolean;
    extern includes(needle: string): boolean;
    extern indexOf(needle: string): int;
    extern lastIndexOf(needle: string): int;
    extern replace(needle: string, replacement: string): string;
    extern substring(start: u64, end: u64): string;
    extern padStart(targetLength: u64, fill: string): string;
    extern padEnd(targetLength: u64, fill: string): string;
    extern toLowerCase(): string;
    extern toUpperCase(): string;
    extern trimStart(): string;
    extern trimEnd(): string;
    extern charCodeAt(index: u64): u32;
    extern startsWith(prefix: string): boolean;
    extern endsWith(suffix: string): boolean;
    extern trim(): string;
    extern repeat(count: u64): string;
    extern reverse(): string;
}
