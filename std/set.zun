// Thin class wrapper over the runtime-owned ordered hash table.
import { set } from "zun:core";

class Set {
    add(value: any): boolean { return set.add(this, value); }
    has(value: any): boolean { return set.has(this, value); }
    size(): u64 { return set.size(this); }
    delete(value: any): boolean { return set.delete(this, value); }
    clear(): void { set.clear(this); }
    values(): Array { return set.values(this); }
    keys(): Array { return set.values(this); }
    entries(): Array { return set.entries(this); }
}
