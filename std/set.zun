// Thin class wrapper over the runtime-owned ordered hash table.
import { setAdd, setHas, setSize, setDelete, setClear } from "zun:collections";

class Set {
    add(value: any): boolean { return setAdd(this, value); }
    has(value: any): boolean { return setHas(this, value); }
    size(): u64 { return setSize(this); }
    delete(value: any): boolean { return setDelete(this, value); }
    clear(): void { setClear(this); }
}
