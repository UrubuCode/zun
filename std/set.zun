// Thin class wrapper over the runtime-owned ordered hash table.
import { set } from "zun:core";

class Set {
    add(value: any): boolean { return set.setAdd(this, value); }
    has(value: any): boolean { return set.setHas(this, value); }
    size(): u64 { return set.setSize(this); }
    delete(value: any): boolean { return set.setDelete(this, value); }
    clear(): void { set.setClear(this); }
    values(): Array { return set.setValues(this); }
    keys(): Array { return set.setValues(this); }
    entries(): Array { return set.setEntries(this); }
}
