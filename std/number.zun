// Numeric conversion helpers implemented in Zun source.

import { parseFloat, toFixed, toString, isFinite, isNaN, isNegativeZero, isSafeInteger } from "zun:number";

class Number {
    abs(): number {
        if (this < 0.0) { return -this; }
        return this;
    }

    isZero(): boolean {
        return this == 0.0;
    }

    isNegative(): boolean {
        return this < 0.0;
    }

    isPositive(): boolean {
        return this > 0.0;
    }

    isNonZero(): boolean {
        return this != 0.0;
    }

    isBetween(low: number, high: number): boolean {
        if (this < low) { return false; }
        return this <= high;
    }

    isInUnitInterval(): boolean {
        return this.isBetween(0.0, 1.0);
    }

    isBetweenExclusive(low: number, high: number): boolean {
        if (this <= low) { return false; }
        return this < high;
    }

    distanceTo(other: number): number {
        return (this - other).abs();
    }

    inverseLerp(low: number, high: number): number {
        if (low == high) { return 0.0; }
        return (this - low) / (high - low);
    }

    smoothStep(edge0: number, edge1: number): number {
        let amount: number = this.inverseLerp(edge0, edge1).clamp(0.0, 1.0);
        return amount * amount * (3.0 - 2.0 * amount);
    }

    isApproximately(other: number, epsilon: number): boolean {
        let difference: number = this - other;
        if (difference < 0.0) { difference = -difference; }
        return difference <= epsilon;
    }

    isNaN(): boolean {
        return isNaN(this);
    }

    extern isNegativeZero(): boolean;

    isFinite(): boolean {
        return isFinite(this);
    }

    isInteger(): boolean {
        return (this as int) as number == this;
    }

    isSafeInteger(): boolean {
        return isSafeInteger(this);
    }

    isEven(): boolean {
        if (!this.isInteger()) { return false; }
        return (this as int) % 2 == 0;
    }

    isOdd(): boolean {
        if (!this.isInteger()) { return false; }
        return (this as int) % 2 != 0;
    }

    toInt(): int {
        return this as int;
    }

    toBoolean(): boolean {
        return this != 0.0;
    }

    sign(): number {
        if (this < 0.0) { return -1.0; }
        if (this > 0.0) { return 1.0; }
        return 0.0;
    }

    clamp(low: number, high: number): number {
        if (this < low) { return low; }
        if (this > high) { return high; }
        return this;
    }

    min(other: number): number {
        if (this < other) { return this; }
        return other;
    }

    max(other: number): number {
        if (this > other) { return this; }
        return other;
    }

    lerp(target: number, amount: number): number {
        return this + (target - this) * amount;
    }

    remap(fromLow: number, fromHigh: number, toLow: number, toHigh: number): number {
        if (fromLow == fromHigh) { return toLow; }
        let amount: number = (this - fromLow) / (fromHigh - fromLow);
        return toLow + (toHigh - toLow) * amount;
    }

    extern toFixed(digits: int): string;
    extern toString(): string;
}

function numberParse(value: string): number {
    return parseFloat(value);
}

function numberToFixed(value: number, digits: int): string {
    return value.toFixed(digits);
}
