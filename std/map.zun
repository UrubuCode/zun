// Thin class wrapper over the runtime-owned ordered hash table.
import { mapSet, mapGet, mapHas, mapSize, mapDelete, mapClear } from "zun:collections";

class Map {
    set(key: any, value: any): void { mapSet(this, key, value); }
    get(key: any): any { return mapGet(this, key); }
    has(key: any): boolean { return mapHas(this, key); }
    size(): u64 { return mapSize(this); }
    delete(key: any): boolean { return mapDelete(this, key); }
    clear(): void { mapClear(this); }
}
