// Thin class wrapper over the runtime-owned ordered hash table.
import { map } from "zun:core";

class Map {
    set(key: any, value: any): void { map.mapSet(this, key, value); }
    get(key: any): any { return map.mapGet(this, key); }
    has(key: any): boolean { return map.mapHas(this, key); }
    size(): u64 { return map.mapSize(this); }
    delete(key: any): boolean { return map.mapDelete(this, key); }
    clear(): void { map.mapClear(this); }
    values(): Array { return map.mapValues(this); }
    keys(): Array { return map.mapKeys(this); }
    entries(): Array { return map.mapEntries(this); }
}
