// Thin class wrapper over the GC ephemeron-backed WeakMap floor.
import { weakMap } from "zun:core";

class WeakMap {
    set(key: any, value: any): boolean { return weakMap.weakMapSet(this, key, value); }
    get(key: any): any { return weakMap.weakMapGet(this, key); }
    has(key: any): boolean { return weakMap.weakMapHas(this, key); }
    delete(key: any): boolean { return weakMap.weakMapDelete(this, key); }
}
