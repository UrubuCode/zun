// Thin class wrapper over the GC ephemeron-backed WeakMap floor.
import { weakMap } from "zun:core";

class WeakMap {
    set(key: any, value: any): boolean { return weakMap.set(this, key, value); }
    get(key: any): any { return weakMap.get(this, key); }
    has(key: any): boolean { return weakMap.has(this, key); }
    delete(key: any): boolean { return weakMap.delete(this, key); }
}
