// Thin source wrapper over the GC ephemeron-backed WeakMap floor.
import { weakMapNew, weakMapSet, weakMapHas } from "zun:collections";

function createWeakMap(): any { return weakMapNew(); }
function setWeakMapValue(map: any, key: any, value: any): boolean { return weakMapSet(map, key, value); }
function hasWeakMapValue(map: any, key: any): boolean { return weakMapHas(map, key); }
