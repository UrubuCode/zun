// Core array helpers implemented in Zun source.

function arrayLength(values: Array): u64 {
    return values.length;
}

function arrayPush(values: Array, value: any): u64 {
    return values.push(value);
}

function arrayPop(values: Array): any {
    return values.pop();
}

function arrayGet(values: Array, index: u64): any {
    return values[index];
}

function arraySet(values: Array, index: u64, value: any): any {
    values[index] = value;
    return value;
}

function arrayContains(values: Array, value: any): boolean {
    let index: u64 = 0;
    while (index < values.length) {
        if (values[index] == value) { return true; }
        index = index + 1;
    }
    return false;
}

function arraySum(values: Array): number {
    let total: number = 0.0;
    let index: u64 = 0;
    while (index < values.length) {
        total = total + (values[index] as number);
        index = index + 1;
    }
    return total;
}
