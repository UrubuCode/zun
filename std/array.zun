// Array is a managed primitive-backed class. Its storage operations lower to
// dedicated IL instructions while higher-level helpers remain source methods.

class Array {
    length(): u64 {
        return this.length;
    }

    push(value: any): u64 {
        return this.push(value);
    }

    pop(): any {
        return this.pop();
    }

    clear(): void {
        while (this.length > 0) {
            this.pop();
        }
    }

    get(index: u64): any {
        return this[index];
    }

    set(index: u64, value: any): any {
        this[index] = value;
        return value;
    }

    removeAt(index: u64): any {
        let removed: any = this[index];
        let cursor: u64 = index;
        while (cursor + 1 < this.length) {
            this[cursor] = this[cursor + 1];
            cursor = cursor + 1;
        }
        this.pop();
        return removed;
    }

    insertAt(index: u64, value: any): Array {
        let cursor: u64 = this.length;
        this.push(value);
        while (cursor > index) {
            this[cursor] = this[cursor - 1];
            cursor = cursor - 1;
        }
        this[index] = value;
        return this;
    }

    removeFirst(value: any): boolean {
        let index: u64 = 0;
        while (index < this.length) {
            if (this[index] == value) {
                this.removeAt(index);
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    removeAll(value: any): u64 {
        let removed: u64 = 0;
        let index: u64 = 0;
        while (index < this.length) {
            if (this[index] == value) {
                this.removeAt(index);
                removed = removed + 1;
            } else {
                index = index + 1;
            }
        }
        return removed;
    }

    swap(first: u64, second: u64): Array {
        let temporary: any = this[first];
        this[first] = this[second];
        this[second] = temporary;
        return this;
    }

    rotateLeft(shift: u64): Array {
        if (this.length == 0) { return this; }
        let amount: u64 = shift % this.length;
        let rotation: u64 = 0;
        while (rotation < amount) {
            let first: any = this[0];
            let index: u64 = 1;
            while (index < this.length) {
                this[index - 1] = this[index];
                index = index + 1;
            }
            this[this.length - 1] = first;
            rotation = rotation + 1;
        }
        return this;
    }

    rotateRight(shift: u64): Array {
        if (this.length == 0) { return this; }
        let amount: u64 = shift % this.length;
        let rotation: u64 = 0;
        while (rotation < amount) {
            let last: any = this[this.length - 1];
            let index: u64 = this.length - 1;
            while (index > 0) {
                this[index] = this[index - 1];
                index = index - 1;
            }
            this[0] = last;
            rotation = rotation + 1;
        }
        return this;
    }

    at(index: u64): any {
        return this[index];
    }

    first(): any {
        return this[0];
    }

    last(): any {
        return this[this.length - 1];
    }

    reverse(): Array {
        let left: u64 = 0;
        if (this.length == 0) { return this; }
        let right: u64 = this.length - 1;
        while (left < right) {
            let temporary: any = this[left];
            this[left] = this[right];
            this[right] = temporary;
            left = left + 1;
            right = right - 1;
        }
        return this;
    }

    fill(value: any): Array {
        let index: u64 = 0;
        while (index < this.length) {
            this[index] = value;
            index = index + 1;
        }
        return this;
    }

    slice(start: u64, end: u64): Array {
        let count: u64 = end - start;
        let result = new Array(count);
        let index: u64 = 0;
        while (index < count) {
            result[index] = this[start + index];
            index = index + 1;
        }
        return result;
    }

    take(count: u64): Array {
        let limit: u64 = count;
        if (limit > this.length) { limit = this.length; }
        return this.slice(0, limit);
    }

    drop(count: u64): Array {
        let start: u64 = count;
        if (start > this.length) { start = this.length; }
        return this.slice(start, this.length);
    }

    concat(other: Array): Array {
        let result = new Array(this.length + other.length);
        let index: u64 = 0;
        while (index < this.length) {
            result[index] = this[index];
            index = index + 1;
        }
        let otherIndex: u64 = 0;
        while (otherIndex < other.length) {
            result[index + otherIndex] = other[otherIndex];
            otherIndex = otherIndex + 1;
        }
        return result;
    }

    copyWithin(target: u64, start: u64, end: u64): Array {
        let copied = this.slice(start, end);
        let index: u64 = 0;
        while (index < copied.length) {
            this[target + index] = copied[index];
            index = index + 1;
        }
        return this;
    }

    flat(): Array {
        let total: u64 = 0;
        let outer: u64 = 0;
        while (outer < this.length) {
            let nested: Array = this[outer] as Array;
            total = total + nested.length;
            outer = outer + 1;
        }
        let result = new Array(total);
        let output: u64 = 0;
        outer = 0;
        while (outer < this.length) {
            let nested: Array = this[outer] as Array;
            let inner: u64 = 0;
            while (inner < nested.length) {
                result[output] = nested[inner];
                output = output + 1;
                inner = inner + 1;
            }
            outer = outer + 1;
        }
        return result;
    }

    transpose(): Array {
        if (this.length == 0) { return new Array(0); }
        let first: Array = this[0] as Array;
        let rows: u64 = this.length;
        let columns: u64 = first.length;
        let result = new Array(columns);
        let column: u64 = 0;
        while (column < columns) {
            let rowResult = new Array(rows);
            let row: u64 = 0;
            while (row < rows) {
                let source: Array = this[row] as Array;
                rowResult[row] = source[column];
                row = row + 1;
            }
            result[column] = rowResult;
            column = column + 1;
        }
        return result;
    }

    chunk(size: u64): Array {
        if (size == 0) { return new Array(0); }
        let groups: u64 = this.length / size;
        if (this.length % size != 0) { groups = groups + 1; }
        let result = new Array(groups);
        let group: u64 = 0;
        let start: u64 = 0;
        while (group < groups) {
            let remaining: u64 = this.length - start;
            let count: u64 = size;
            if (remaining < count) { count = remaining; }
            let part = new Array(count);
            let index: u64 = 0;
            while (index < count) {
                part[index] = this[start + index];
                index = index + 1;
            }
            result[group] = part;
            start = start + count;
            group = group + 1;
        }
        return result;
    }

    windowed(size: u64): Array {
        if (size == 0) { return new Array(0); }
        if (size > this.length) { return new Array(0); }
        let count: u64 = this.length - size + 1;
        let result = new Array(count);
        let start: u64 = 0;
        while (start < count) {
            let window = new Array(size);
            let index: u64 = 0;
            while (index < size) {
                window[index] = this[start + index];
                index = index + 1;
            }
            result[start] = window;
            start = start + 1;
        }
        return result;
    }

    contains(value: any): boolean {
    let index: u64 = 0;
    while (index < this.length) {
        if (this[index] == value) { return true; }
        index = index + 1;
    }
    return false;
    }

    all(value: any): boolean {
        let index: u64 = 0;
        while (index < this.length) {
            if (this[index] != value) { return false; }
            index = index + 1;
        }
        return true;
    }

    none(value: any): boolean {
        let index: u64 = 0;
        while (index < this.length) {
            if (this[index] == value) { return false; }
            index = index + 1;
        }
        return true;
    }

    any(value: any): boolean {
        let index: u64 = 0;
        while (index < this.length) {
            if (this[index] == value) { return true; }
            index = index + 1;
        }
        return false;
    }

    isConstant(): boolean {
        if (this.length < 2) { return true; }
        let first: any = this[0];
        let index: u64 = 1;
        while (index < this.length) {
            if (this[index] != first) { return false; }
            index = index + 1;
        }
        return true;
    }

    isPalindrome(): boolean {
        if (this.length < 2) { return true; }
        let left: u64 = 0;
        let right: u64 = this.length - 1;
        while (left < right) {
            if (this[left] != this[right]) { return false; }
            left = left + 1;
            right = right - 1;
        }
        return true;
    }

    isDisjoint(other: Array): boolean {
        let left: u64 = 0;
        while (left < this.length) {
            let right: u64 = 0;
            while (right < other.length) {
                if (this[left] == other[right]) { return false; }
                right = right + 1;
            }
            left = left + 1;
        }
        return true;
    }

    intersection(other: Array): Array {
        let matches: u64 = 0;
        let left: u64 = 0;
        while (left < this.length) {
            let right: u64 = 0;
            while (right < other.length) {
                if (this[left] == other[right]) {
                    matches = matches + 1;
                    break;
                }
                right = right + 1;
            }
            left = left + 1;
        }
        let result = new Array(matches);
        let output: u64 = 0;
        left = 0;
        while (left < this.length) {
            let right: u64 = 0;
            while (right < other.length) {
                if (this[left] == other[right]) {
                    result[output] = this[left];
                    output = output + 1;
                    break;
                }
                right = right + 1;
            }
            left = left + 1;
        }
        return result;
    }

    difference(other: Array): Array {
        let remaining: u64 = 0;
        let left: u64 = 0;
        while (left < this.length) {
            let right: u64 = 0;
            let found: boolean = false;
            while (right < other.length) {
                if (this[left] == other[right]) { found = true; break; }
                right = right + 1;
            }
            if (!found) { remaining = remaining + 1; }
            left = left + 1;
        }
        let result = new Array(remaining);
        let output: u64 = 0;
        left = 0;
        while (left < this.length) {
            let right: u64 = 0;
            let found: boolean = false;
            while (right < other.length) {
                if (this[left] == other[right]) { found = true; break; }
                right = right + 1;
            }
            if (!found) {
                result[output] = this[left];
                output = output + 1;
            }
            left = left + 1;
        }
        return result;
    }

    union(other: Array): Array {
        let total: u64 = this.length;
        let right: u64 = 0;
        while (right < other.length) {
            if (!this.contains(other[right])) { total = total + 1; }
            right = right + 1;
        }
        let result = new Array(total);
        let index: u64 = 0;
        while (index < this.length) {
            result[index] = this[index];
            index = index + 1;
        }
        right = 0;
        while (right < other.length) {
            if (!this.contains(other[right])) {
                result[index] = other[right];
                index = index + 1;
            }
            right = right + 1;
        }
        return result;
    }

    symmetricDifference(other: Array): Array {
        let leftOnly = this.difference(other);
        let rightOnly = other.difference(this);
        return leftOnly.union(rightOnly);
    }

    isSubsetOf(other: Array): boolean {
        let index: u64 = 0;
        while (index < this.length) {
            if (!other.contains(this[index])) { return false; }
            index = index + 1;
        }
        return true;
    }

    isSupersetOf(other: Array): boolean {
        return other.isSubsetOf(this);
    }

    count(value: any): u64 {
        let total: u64 = 0;
        let index: u64 = 0;
        while (index < this.length) {
            if (this[index] == value) { total = total + 1; }
            index = index + 1;
        }
        return total;
    }

    includes(value: any): boolean {
        return this.contains(value);
    }

    indexOf(value: any): int {
        let index: u64 = 0;
        while (index < this.length) {
            if (this[index] == value) { return index as int; }
            index = index + 1;
        }
        return -1;
    }

    findIndex(value: any): int {
        return this.indexOf(value);
    }

    lastIndexOf(value: any): int {
        let index: int = this.length as int;
        while (index > 0) {
            index = index - 1;
            if (this[index as u64] == value) { return index; }
        }
        return -1;
    }

    isEmpty(): boolean {
        return this.length == 0;
    }

    equals(other: Array): boolean {
        if (this.length != other.length) { return false; }
        let index: u64 = 0;
        while (index < this.length) {
            if (this[index] != other[index]) { return false; }
            index = index + 1;
        }
        return true;
    }

    isSorted(): boolean {
        if (this.length < 2) { return true; }
        let index: u64 = 1;
        while (index < this.length) {
            let previous: number = this[index - 1] as number;
            let current: number = this[index] as number;
            if (current < previous) { return false; }
            index = index + 1;
        }
        return true;
    }

    isDescending(): boolean {
        if (this.length < 2) { return true; }
        let index: u64 = 1;
        while (index < this.length) {
            let previous: number = this[index - 1] as number;
            let current: number = this[index] as number;
            if (current > previous) { return false; }
            index = index + 1;
        }
        return true;
    }

    isUnique(): boolean {
        let outer: u64 = 0;
        while (outer < this.length) {
            let inner: u64 = outer + 1;
            while (inner < this.length) {
                if (this[outer] == this[inner]) { return false; }
                inner = inner + 1;
            }
            outer = outer + 1;
        }
        return true;
    }

    sum(): number {
    let total: number = 0.0;
    let index: u64 = 0;
    while (index < this.length) {
        total = total + (this[index] as number);
        index = index + 1;
    }
    return total;
    }

    product(): number {
        let total: number = 1.0;
        let index: u64 = 0;
        while (index < this.length) {
            total = total * (this[index] as number);
            index = index + 1;
        }
        return total;
    }

    average(): number {
        if (this.length == 0) { return 0.0; }
        return this.sum() / (this.length as number);
    }

    min(): number {
        if (this.length == 0) { return 0.0; }
        let result: number = this[0] as number;
        let index: u64 = 1;
        while (index < this.length) {
            let value: number = this[index] as number;
            if (value < result) { result = value; }
            index = index + 1;
        }
        return result;
    }

    max(): number {
        if (this.length == 0) { return 0.0; }
        let result: number = this[0] as number;
        let index: u64 = 1;
        while (index < this.length) {
            let value: number = this[index] as number;
            if (value > result) { result = value; }
            index = index + 1;
        }
        return result;
    }

    sort(): Array {
        let index: u64 = 0;
        while (index < this.length) {
            let smallest: u64 = index;
            let scan: u64 = index + 1;
            while (scan < this.length) {
                let candidate: number = this[scan] as number;
                let currentSmallest: number = this[smallest] as number;
                if (candidate < currentSmallest) { smallest = scan; }
                scan = scan + 1;
            }
            let temporary: any = this[index];
            this[index] = this[smallest];
            this[smallest] = temporary;
            index = index + 1;
        }
        return this;
    }
}
