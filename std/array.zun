// Array is a managed primitive-backed class. Its storage operations lower to
// dedicated IL instructions while higher-level helpers remain source methods.

class Array {
    length(): u64 {
        return this.length;
    }

    push(value: any): u64 {
        return this.push(value);
    }

    pop(): any {
        return this.pop();
    }

    clear(): void {
        while (this.length > 0) {
            this.pop();
        }
    }

    get(index: u64): any {
        return this[index];
    }

    set(index: u64, value: any): any {
        this[index] = value;
        return value;
    }

    at(index: u64): any {
        return this[index];
    }

    first(): any {
        return this[0];
    }

    last(): any {
        return this[this.length - 1];
    }

    reverse(): Array {
        let left: u64 = 0;
        if (this.length == 0) { return this; }
        let right: u64 = this.length - 1;
        while (left < right) {
            let temporary: any = this[left];
            this[left] = this[right];
            this[right] = temporary;
            left = left + 1;
            right = right - 1;
        }
        return this;
    }

    fill(value: any): Array {
        let index: u64 = 0;
        while (index < this.length) {
            this[index] = value;
            index = index + 1;
        }
        return this;
    }

    slice(start: u64, end: u64): Array {
        let count: u64 = end - start;
        let result = new Array(count);
        let index: u64 = 0;
        while (index < count) {
            result[index] = this[start + index];
            index = index + 1;
        }
        return result;
    }

    concat(other: Array): Array {
        let result = new Array(this.length + other.length);
        let index: u64 = 0;
        while (index < this.length) {
            result[index] = this[index];
            index = index + 1;
        }
        let otherIndex: u64 = 0;
        while (otherIndex < other.length) {
            result[index + otherIndex] = other[otherIndex];
            otherIndex = otherIndex + 1;
        }
        return result;
    }

    copyWithin(target: u64, start: u64, end: u64): Array {
        let copied = this.slice(start, end);
        let index: u64 = 0;
        while (index < copied.length) {
            this[target + index] = copied[index];
            index = index + 1;
        }
        return this;
    }

    flat(): Array {
        let total: u64 = 0;
        let outer: u64 = 0;
        while (outer < this.length) {
            let nested: Array = this[outer] as Array;
            total = total + nested.length;
            outer = outer + 1;
        }
        let result = new Array(total);
        let output: u64 = 0;
        outer = 0;
        while (outer < this.length) {
            let nested: Array = this[outer] as Array;
            let inner: u64 = 0;
            while (inner < nested.length) {
                result[output] = nested[inner];
                output = output + 1;
                inner = inner + 1;
            }
            outer = outer + 1;
        }
        return result;
    }

    contains(value: any): boolean {
    let index: u64 = 0;
    while (index < this.length) {
        if (this[index] == value) { return true; }
        index = index + 1;
    }
    return false;
    }

    count(value: any): u64 {
        let total: u64 = 0;
        let index: u64 = 0;
        while (index < this.length) {
            if (this[index] == value) { total = total + 1; }
            index = index + 1;
        }
        return total;
    }

    includes(value: any): boolean {
        return this.contains(value);
    }

    indexOf(value: any): int {
        let index: u64 = 0;
        while (index < this.length) {
            if (this[index] == value) { return index as int; }
            index = index + 1;
        }
        return -1;
    }

    isEmpty(): boolean {
        return this.length == 0;
    }

    sum(): number {
    let total: number = 0.0;
    let index: u64 = 0;
    while (index < this.length) {
        total = total + (this[index] as number);
        index = index + 1;
    }
    return total;
    }
}
