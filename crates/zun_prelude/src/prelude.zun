// Zun base prelude — numeric helpers written in Zun, using the fixed-width
// numeric types. These compile with every program and, being pure numeric
// functions, are JIT-eligible (they run as native code once hot).
//
// Until a module system exists this prelude is concatenated after the user's
// source, so these names are effectively reserved.

// --- integer (i32) helpers ---

function abs(x: int): int {
    if (x < 0) { return -x; }
    return x;
}

function min(a: int, b: int): int {
    if (a < b) { return a; }
    return b;
}

function max(a: int, b: int): int {
    if (a > b) { return a; }
    return b;
}

function clamp(x: int, lo: int, hi: int): int {
    return min(max(x, lo), hi);
}

// Integer power by repeated multiplication (exp assumed non-negative).
function powi(base: int, exp: int): int {
    let result: int = 1;
    let i: int = 0;
    while (i < exp) {
        result = result * base;
        i = i + 1;
    }
    return result;
}

function sign(x: int): int {
    if (x > 0) { return 1; }
    if (x < 0) { return -1; }
    return 0;
}

// --- float (f64) helpers ---

function fabs(x: float): float {
    if (x < 0.0) { return -x; }
    return x;
}

function fmin(a: float, b: float): float {
    if (a < b) { return a; }
    return b;
}

function fmax(a: float, b: float): float {
    if (a > b) { return a; }
    return b;
}

// --- WinterCG universal globals (self-contained over `zun:core`) ---

import { serialize as serdeSerialize, deserialize as serdeDeserialize, nodeBuffer as globalsBuffer } from "zun:core";

// Deep clone through the binary ser/de primitive; cycles and shared
// references round-trip. `options.transfer` lists ArrayBuffers to move: each
// must be an attached, distinct ArrayBuffer (else a `DataCloneError`), and is
// detached once the clone has been built, so a failed clone leaves them intact.
// No default on `options`: a default lowers `Function.prototype.length`, and
// node reports `structuredClone.length === 2`. The body already treats an
// absent argument as `undefined`.
function structuredClone(value: any, options: any): any {
    let transfer: any = undefined;
    if (options !== undefined && options !== null) {
        transfer = options.transfer;
    }
    if (transfer === undefined || transfer === null) {
        return serdeDeserialize(serdeSerialize(value));
    }
    const list: any[] = [...transfer];
    let i = 0;
    while (i < list.length) {
        const item: any = list[i];
        if (!(item instanceof ArrayBuffer)) {
            throw new DOMException("Value not transferable", "DataCloneError");
        }
        if (item.detached) {
            throw new DOMException("An ArrayBuffer is detached and could not be cloned.", "DataCloneError");
        }
        let j = 0;
        while (j < i) {
            if (list[j] === item) {
                throw new DOMException("ArrayBuffer at index " + i + " is a duplicate of an earlier ArrayBuffer.", "DataCloneError");
            }
            j = j + 1;
        }
        i = i + 1;
    }
    const cloned: any = serdeDeserialize(serdeSerialize(value));
    i = 0;
    while (i < list.length) {
        list[i].transfer();
        i = i + 1;
    }
    return cloned;
}

import { codegen as zunCodegen } from "zun:core";

// `eval` as a function value: called through a comma expression, an alias or
// `globalThis`. Always the *indirect* form: the source runs as global code. A
// direct call on a string literal holding one expression is resolved by the
// compiler in the caller's scope and never reaches this.
//
// The space before the parameter list, and the wording above, are deliberate:
// the checker keeps every module-binding mirror alive when the source text
// (prelude included) contains the name immediately followed by an opening
// parenthesis, so this file must not spell that sequence.
function eval (x: any): any {
    return zunCodegen.indirectEval(x);
}

// Base64-encode a binary string (code points 0-255, as in the web `btoa`).
function btoa(data?: any): string {
    let bytes = globalsBuffer.nodeBufferFromString(String(data), "latin1");
    return globalsBuffer.nodeBufferToString(bytes, "base64", 0, bytes.length);
}

// Base64-decode to a binary string (inverse of `btoa`).
function atob(data?: any): string {
    let bytes = globalsBuffer.nodeBufferFromString(String(data), "base64");
    return globalsBuffer.nodeBufferToString(bytes, "latin1", 0, bytes.length);
}

// Coercion constructors read as first-class values (`xs.map(String)`,
// `xs.filter(Boolean)`); the checker maps the identifiers to these.
function __coerceString(value: any): string {
    return String(value);
}

// `String.prototype.valueOf.call(v)` / `.toString.call(v)`: thisStringValue, not
// ToString -- only a string (or a String object, which zun represents as the
// primitive) is accepted; anything else is a TypeError.
function __thisStringValue(value: any): string {
    if (typeof value === "string") {
        return value;
    }
    // A `new String(...)` wrapper: an instance of the prelude wrapper class,
    // which is what holds the [[StringData]]. Not the builtin tag -- that
    // honours a user `Symbol.toStringTag`, so a plain object tagged "String"
    // was accepted where it must be a TypeError.
    if (value instanceof StringObject) {
        return (value as StringObject).value;
    }
    throw new TypeError("String.prototype.valueOf requires that 'this' be a String");
}

function __coerceNumber(value: any): number {
    return Number(value);
}

function __coerceBoolean(value: any): boolean {
    return Boolean(value);
}

// `Symbol` read as a value is a class descriptor, yet it is callable
// (`const S: any = Symbol; S("d")`, `Symbol.call(undefined, "d")`): the
// interpreter runs this function when that descriptor is called rather than
// constructed. `new Symbol()` never reaches it and still throws.
function __zunSymbolCall(description?: any): any {
    return Symbol(description);
}

// `new` on a class whose base refuses construction (`class B extends BigInt {}`,
// `class S extends Symbol {}`): the implicit `super(...)` throws.
function __zunNotConstructor(name: string): any {
    throw new TypeError(name + " is not a constructor");
}

// Assignment to an immutable binding: a class or function declaration's own
// name. JS makes this a run-time TypeError (a class body is strict code), not
// a compile error -- the inner class-name binding is const, so
// `class D { static f() { D = 1 } }` throws when `f` runs.
function __zunAssignToConstant(): any {
    throw new TypeError("Assignment to constant variable.");
}

// `String.prototype.m.call(thisArg, ...)`: RequireObjectCoercible + ToString of
// the receiver (the adapter rewrites the call onto `ToString(thisArg).m(...)`).
function __thisString(value: any): string {
    if (value === null || value === undefined) {
        throw new TypeError("String.prototype method called on null or undefined");
    }
    // ToString, not `String(value)`: a Symbol receiver is a TypeError here.
    if (typeof value === "symbol") {
        throw new TypeError("Cannot convert a Symbol value to a string");
    }
    return String(value);
}

// --- URI and legacy escaping globals (over `encodeURIComponent` / `decodeURIComponent`) ---

function __hex2(code: number): string {
    const digits = "0123456789ABCDEF";
    return digits.charAt((code >> 4) & 15) + digits.charAt(code & 15);
}

// `encodeURI`: like `encodeURIComponent` but the reserved set `;/?:@&=+$,#` stays literal.
function encodeURI(value?: any): string {
    const s: string = String(value);
    const keep = ";/?:@&=+$,#";
    let out = "";
    let i = 0;
    while (i < s.length) {
        const ch = s.charAt(i);
        if (keep.indexOf(ch) >= 0) {
            out += ch;
            i += 1;
        } else {
            const c = s.charCodeAt(i);
            let width = 1;
            if (c >= 0xd800 && c <= 0xdbff && i + 1 < s.length) {
                const d = s.charCodeAt(i + 1);
                if (d >= 0xdc00 && d <= 0xdfff) {
                    width = 2;
                }
            }
            out += encodeURIComponent(s.substring(i, i + width));
            i += width;
        }
    }
    return out;
}

function __hexValue(c: number): number {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 65 && c <= 70) { return c - 55; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return -1;
}

// `decodeURI`: like `decodeURIComponent` but escapes of reserved characters stay encoded.
function decodeURI(value?: any): string {
    const s: string = String(value);
    const reserved = ";/?:@&=+$,#";
    let out = "";
    let run = "";
    let i = 0;
    while (i < s.length) {
        if (s.charAt(i) == "%") {
            const hi = i + 2 < s.length + 0 ? __hexValue(s.charCodeAt(i + 1)) : -1;
            const lo = i + 2 < s.length + 0 ? __hexValue(s.charCodeAt(i + 2)) : -1;
            if (hi >= 0 && lo >= 0 && hi * 16 + lo < 128 && reserved.indexOf(String.fromCharCode(hi * 16 + lo)) >= 0) {
                if (run.length > 0) {
                    out += decodeURIComponent(run);
                    run = "";
                }
                out += s.substring(i, i + 3);
            } else {
                run += s.charAt(i);
                if (i + 2 < s.length) {
                    run += s.substring(i + 1, i + 3);
                    i += 2;
                }
            }
            i += 1;
        } else {
            if (run.length > 0) {
                out += decodeURIComponent(run);
                run = "";
            }
            out += s.charAt(i);
            i += 1;
        }
    }
    if (run.length > 0) {
        out += decodeURIComponent(run);
    }
    return out;
}

// Legacy `escape`: Latin-1 as %XX, other code units as %uXXXX.
function escape(value?: any): string {
    const s: string = String(value);
    const safe = "@*_+-./";
    let out = "";
    let i = 0;
    while (i < s.length) {
        const c = s.charCodeAt(i);
        const ch = s.charAt(i);
        if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || safe.indexOf(ch) >= 0) {
            out += ch;
        } else if (c < 256) {
            out += "%" + __hex2(c);
        } else {
            out += "%u" + __hex2(c >> 8) + __hex2(c & 255);
        }
        i += 1;
    }
    return out;
}

function unescape(value?: any): string {
    const s: string = String(value);
    let out = "";
    let i = 0;
    while (i < s.length) {
        const ch = s.charAt(i);
        if (ch == "%") {
            if (i + 5 < s.length + 0 && s.charAt(i + 1) == "u") {
                const a = __hexValue(s.charCodeAt(i + 2));
                const b = __hexValue(s.charCodeAt(i + 3));
                const c = __hexValue(s.charCodeAt(i + 4));
                const d = __hexValue(s.charCodeAt(i + 5));
                if (a >= 0 && b >= 0 && c >= 0 && d >= 0) {
                    out += String.fromCharCode(a * 4096 + b * 256 + c * 16 + d);
                    i += 6;
                    continue;
                }
            }
            if (i + 2 < s.length) {
                const a = __hexValue(s.charCodeAt(i + 1));
                const b = __hexValue(s.charCodeAt(i + 2));
                if (a >= 0 && b >= 0) {
                    out += String.fromCharCode(a * 16 + b);
                    i += 3;
                    continue;
                }
            }
        }
        out += ch;
        i += 1;
    }
    return out;
}

import { string as uriString } from "zun:core";

// First-class forms of the two component coders (direct calls with one argument
// are lowered to the same intrinsics by the checker).
function encodeURIComponent(value?: any): string {
    return uriString.encodeURIComponent(String(value));
}

function decodeURIComponent(value?: any): string {
    return uriString.decodeURIComponent(String(value));
}

// `Array.prototype.slice.call(arrayLike, start, end)`: ToIntegerOrInfinity of
// each index runs **before** any element is read, so a throwing `valueOf`
// aborts with nothing touched. `undefined` is passed through, because a
// `slice` end of `undefined` means "to the length", not 0.
function __zunSliceIndex(value: any): any {
    if (value === undefined) {
        return undefined;
    }
    const n: number = Number(value);
    if (n !== n) {
        return 0;
    }
    return Math.trunc(n);
}

// `Array.prototype.<cb-method>.call(arrayLike, cb)`: the spec validates the
// callback with IsCallable **before** reading any element, so a non-callable
// must throw before the array-like is materialized. Zun's borrowed-method
// lowering converts the receiver first, which read index 0 of a Proxy before
// throwing; the lowering now routes the callback through this guard.
// IteratorNext: the `{ value, done }` result must be an Object. The `yield*`
// desugaring reads the two keys off it, which on a primitive silently answer
// `undefined`, so the check has to be explicit.
function __zunRequireIterResult(value: any): any {
    if (value === null || typeof value !== "object") {
        throw new TypeError("Iterator result " + String(value) + " is not an object");
    }
    return value;
}

function __zunRequireCallable(value: any): any {
    if (typeof value !== "function") {
        throw new TypeError(String(value) + " is not a function");
    }
    return value;
}

// --- Timers as first-class values ---
//
// `setTimeout` and friends are lowered at the *call* site by the checker onto
// the VM's timer intrinsics, so the bare names were callable but had no value:
// `setTimeout.length` and `globalThis.setTimeout === setTimeout` both failed.
// Declaring prelude functions under those names is not an option -- the
// prelude is concatenated after the user source, so zun-node's own
// `setTimeout` would become a duplicate declaration (issue #111). These
// mangled helpers carry the value instead; the checker maps the bare name and
// the realm global onto them, so both spellings are the same function object.
// Each takes its callback as a required parameter so `length` is 1, as in node.

function __zunSetTimeout(callback: any, delay: any = 0, ...rest: any[]): any {
    if (rest.length > 0) {
        return setTimeout(function () { callback.apply(undefined, rest); }, delay);
    }
    return setTimeout(callback, delay);
}

function __zunSetInterval(callback: any, delay: any = 0, ...rest: any[]): any {
    if (rest.length > 0) {
        return setInterval(function () { callback.apply(undefined, rest); }, delay);
    }
    return setInterval(callback, delay);
}

function __zunClearTimeout(handle: any = undefined): any {
    clearTimeout(handle);
    return undefined;
}

function __zunClearInterval(handle: any = undefined): any {
    clearInterval(handle);
    return undefined;
}

function __zunQueueMicrotask(callback: any): any {
    queueMicrotask(callback);
    return undefined;
}

function __zunSetImmediate(callback: any, ...rest: any[]): any {
    if (rest.length > 0) {
        return setImmediate(function () { callback.apply(undefined, rest); });
    }
    return setImmediate(callback);
}

// `Buffer.compare` as a first-class value (`[..].sort(Buffer.compare)`). The
// static is lowered onto an intrinsic at the call site, so the bare read had no
// value; the checker maps it onto this helper.
function __zunBufferCompare(a: any, b: any): number {
    return Buffer.compare(a, b);
}

// A `let` / `const` read before its declaration (the temporal dead zone). The
// checker lowers such a read -- `typeof` included -- onto this call when the
// declaration is further down an enclosing block of the same function.
function __zunDeadZone(name: string): any {
    throw new ReferenceError("Cannot access '" + name + "' before initialization");
}

// `parseInt` / `parseFloat` as first-class values. Both are lowered at the call
// site, so the global and `Number.parseInt` each had a value of their own and
// `Number.parseInt === parseInt` was false; the specification makes them one
// function object. The checker maps both spellings onto these helpers.
function __zunParseInt(text: any, radix: any): number {
    return parseInt(text, radix);
}

function __zunParseFloat(text: any): number {
    return parseFloat(text);
}
