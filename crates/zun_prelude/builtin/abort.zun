// Nucleus `AbortSignal` / `AbortController` (DOM, prelude classes).
//
//   new AbortController()  -> { signal, abort(reason?) }
//   AbortSignal            -> { aborted, reason, addEventListener,
//                               removeEventListener, dispatchEvent,
//                               throwIfAborted() }, static AbortSignal.abort(reason?)
//
// An `AbortSignal` is an event target by composition (it owns an `EventTarget`
// and forwards the three listener methods), because prelude classes have no
// constructor bodies to chain through an `extends`. See `event_target.zun` for
// how listener functions are stored.
//
// Simplifications (documented, not defects):
//   * `AbortSignal.abort(reason)` requires its argument (a default on a static
//     method is not honored by the engine yet); `AbortController.abort()` may omit it.
//   * `abort()` without a reason sets `reason` to `null` (not a `DOMException`).
//   * `AbortSignal.timeout` / `AbortSignal.any` and the `onabort` handler are
//     deferred; `new AbortSignal()` directly is possible but not meaningful.
//   * `throwIfAborted` throws an `Error("AbortError: <reason>")` (only `Error`
//     values can be thrown), not the raw reason.

// Extends `EventTarget` rather than delegating to one: `signal instanceof
// EventTarget` must be true, and `event.currentTarget` inside a listener must
// be the signal, which a held-and-forwarded inner target can never report.
class AbortSignal extends EventTarget {
    aborted: boolean = false;
    // `undefined` before an abort, as node reports it -- not `null`.
    reason: any = undefined;

    // `onabort` is an event-handler property: assigning replaces the previous
    // handler but keeps the position it was first registered in, so it fires
    // between the listeners added before and after it. Assigning `null` clears
    // it. The backing listener is registered once, on first assignment, and
    // reads the current handler when it fires -- which is what gives
    // replacement its position-preserving behaviour.
    onabortHandler: any = null;
    onabortRegistered: boolean = false;

    get onabort(): any {
        return this.onabortHandler;
    }

    set onabort(value: any) {
        this.onabortHandler = value;
        if (!this.onabortRegistered) {
            this.onabortRegistered = true;
            this.addEventListener("abort", (event: any): void => {
                const handler: any = this.onabortHandler;
                if (handler !== null && handler !== undefined) {
                    handler(event);
                }
            });
        }
    }

    // `throwIfAborted` throws the reason **itself**, not a copy: the fixture
    // asserts `thrown === signal.reason`, and a fresh `Error` fails that and
    // carries the wrong `name`.
    throwIfAborted(): void {
        if (this.aborted) {
            throw this.reason;
        }
    }

    // Marks the signal aborted (once) and fires its "abort" event.
    //
    // An absent reason becomes the spec's `AbortError` `DOMException`, so
    // `signal.reason.name` is `"AbortError"` and the reason is an `Error`.
    // It used to stay `null`, and reading `.name` off it threw.
    markAborted(reason: any): void {
        if (this.aborted) {
            return;
        }
        this.aborted = true;
        if (reason === undefined) {
            this.reason = new DOMException("This operation was aborted", "AbortError");
        } else {
            this.reason = reason;
        }
        this.dispatchEvent(new Event("abort"));
    }

    static abort(reason: any): AbortSignal {
        let signal = new AbortSignal();
        signal.markAborted(reason);
        return signal;
    }

    // `AbortSignal.any(signals)`: aborts as soon as any input does, with that
    // input's reason. An input already aborted at call time settles the result
    // immediately -- which is why a listener attached afterwards never runs --
    // and `markAborted` being idempotent is what makes a later abort a no-op.
    static any(signals: any): AbortSignal {
        const result: AbortSignal = new AbortSignal();
        const list: any[] = [...signals];
        let index: number = 0;
        while (index < list.length) {
            const early: any = list[index];
            if (early.aborted) {
                result.markAborted(early.reason);
                return result;
            }
            index = index + 1;
        }
        index = 0;
        while (index < list.length) {
            const source: any = list[index];
            source.addEventListener("abort", (): void => {
                result.markAborted(source.reason);
            });
            index = index + 1;
        }
        return result;
    }
}

class AbortController {
    signal: AbortSignal = new AbortSignal();

    // The default is `undefined`, not `null`: `markAborted` turns an absent
    // reason into the spec's `AbortError` `DOMException`, and `null` is a
    // reason the caller can legitimately pass.
    abort(reason: any = undefined): void {
        this.signal.markAborted(reason);
    }
}
