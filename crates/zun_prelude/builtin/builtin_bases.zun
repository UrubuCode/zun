// Wrapper base classes behind `class X extends <Built-in>`.
//
// Built-in values (Promise, Map, Set, ...) are runtime-owned and have no class
// layout a user class could extend. The checker therefore maps `extends
// Promise` onto `__BuiltinPromise`: an ordinary class that owns the native value
// in `inner` and forwards the built-in's surface to it. A subclass instance is
// a thenable / iterable-by-forwarding object rather than the native value
// itself, which is enough for `await`, `then` chains and statics inheritance.

class __BuiltinPromise {
    inner: any;

    constructor(executor: any) {
        const w: any = Promise.withResolvers();
        this.inner = w.promise;
        try {
            executor(w.resolve, w.reject);
        } catch (e) {
            w.reject(e);
        }
    }

    // The derived promise is built by the species constructor (`this.constructor[Symbol.species]`);
    // a species of `Promise` itself yields a plain native promise.
    __derive(p: any): any {
        const C: any = (this as any).constructor;
        const S: any = C[Symbol.species];
        if (S === undefined || S === null || S === Promise) {
            return p;
        }
        return new S((res: any, rej: any) => {
            p.then(res, rej);
        });
    }

    then(onFulfilled?: any, onRejected?: any): any {
        return this.__derive(this.inner.then(onFulfilled, onRejected));
    }

    catch(onRejected?: any): any {
        return this.then(undefined, onRejected);
    }

    finally(onFinally?: any): any {
        return this.__derive(this.inner.finally(onFinally));
    }

    static resolve(value: any): any {
        const C: any = this;
        return new C((res: any, rej: any) => res(value));
    }

    static reject(reason: any): any {
        const C: any = this;
        return new C((res: any, rej: any) => rej(reason));
    }

    static all(items: any): any {
        return Promise.all(items);
    }

    static allSettled(items: any): any {
        return Promise.allSettled(items);
    }

    static race(items: any): any {
        return Promise.race(items);
    }

    static any(items: any): any {
        return Promise.any(items);
    }
}

class __BuiltinMap {
    inner: Map<any, any> = new Map();

    constructor(iterable?: any) {
        if (iterable !== undefined && iterable !== null) {
            for (const entry of iterable) {
                this.set(entry[0], entry[1]);
            }
        }
    }

    set(key: any, value: any): any {
        this.inner.set(key, value);
        return this;
    }

    get(key: any): any {
        return this.inner.get(key);
    }

    has(key: any): boolean {
        return this.inner.has(key);
    }

    delete(key: any): boolean {
        return this.inner.delete(key);
    }

    clear(): void {
        this.inner.clear();
    }

    get size(): number {
        return this.inner.size;
    }

    keys(): any {
        return this.inner.keys();
    }

    values(): any {
        return this.inner.values();
    }

    entries(): any {
        return this.inner.entries();
    }

    forEach(callback: any, thisArg?: any): void {
        const self = this;
        this.inner.forEach((value: any, key: any) => {
            callback(value, key, self);
        });
    }

    *[Symbol.iterator](): any {
        for (const entry of this.inner.entries()) {
            yield entry;
        }
    }
}

class __BuiltinSet {
    inner: Set<any> = new Set();

    constructor(iterable?: any) {
        if (iterable !== undefined && iterable !== null) {
            for (const value of iterable) {
                this.add(value);
            }
        }
    }

    add(value: any): any {
        this.inner.add(value);
        return this;
    }

    has(value: any): boolean {
        return this.inner.has(value);
    }

    delete(value: any): boolean {
        return this.inner.delete(value);
    }

    clear(): void {
        this.inner.clear();
    }

    get size(): number {
        return this.inner.size;
    }

    keys(): any {
        return this.inner.values();
    }

    values(): any {
        return this.inner.values();
    }

    entries(): any {
        return this.inner.entries();
    }

    forEach(callback: any, thisArg?: any): void {
        const self = this;
        this.inner.forEach((value: any) => {
            callback(value, value, self);
        });
    }

    union(other: any): any {
        return __zunSetOpSet(this.inner, "union", other);
    }

    intersection(other: any): any {
        return __zunSetOpSet(this.inner, "intersection", other);
    }

    difference(other: any): any {
        return __zunSetOpSet(this.inner, "difference", other);
    }

    symmetricDifference(other: any): any {
        return __zunSetOpSet(this.inner, "symmetricDifference", other);
    }

    isSubsetOf(other: any): any {
        return __zunSetOpBool(this.inner, "isSubsetOf", other);
    }

    isSupersetOf(other: any): any {
        return __zunSetOpBool(this.inner, "isSupersetOf", other);
    }

    isDisjointFrom(other: any): any {
        return __zunSetOpBool(this.inner, "isDisjointFrom", other);
    }

    *[Symbol.iterator](): any {
        for (const value of this.inner.values()) {
            yield value;
        }
    }
}

class __BuiltinWeakSet {
    inner: WeakSet<any> = new WeakSet();

    constructor(iterable?: any) {
        if (iterable !== undefined && iterable !== null) {
            for (const value of iterable) {
                this.add(value);
            }
        }
    }

    add(value: any): any {
        this.inner.add(value);
        return this;
    }

    has(value: any): boolean {
        return this.inner.has(value);
    }

    delete(value: any): boolean {
        return this.inner.delete(value);
    }
}

class __BuiltinWeakMap {
    inner: WeakMap<any, any> = new WeakMap();

    constructor(iterable?: any) {
        if (iterable !== undefined && iterable !== null) {
            for (const entry of iterable) {
                this.set(entry[0], entry[1]);
            }
        }
    }

    set(key: any, value: any): any {
        this.inner.set(key, value);
        return this;
    }

    get(key: any): any {
        return this.inner.get(key);
    }

    has(key: any): boolean {
        return this.inner.has(key);
    }

    delete(key: any): boolean {
        return this.inner.delete(key);
    }
}

// `new WeakSet(iterable)` / `new WeakMap(iterable)`: build the empty weak
// collection, then add each element / entry (a primitive key throws).
function __zunWeakSetFrom(items: any): WeakSet<any> {
    const set = new WeakSet<any>();
    if (items === undefined || items === null) {
        return set;
    }
    for (const value of items) {
        set.add(value);
    }
    return set;
}

function __zunWeakMapFrom(items: any): WeakMap<any, any> {
    const map = new WeakMap<any, any>();
    if (items === undefined || items === null) {
        return map;
    }
    for (const entry of items) {
        map.set(entry[0], entry[1]);
    }
    return map;
}

// `Map.groupBy(items, callback)`: group by the callback's key (SameValueZero),
// preserving first-appearance order of keys and encounter order inside groups.
function __zunMapGroupBy(items: any, callback: any): Map<any, any> {
    const groups = new Map<any, any>();
    let index = 0;
    for (const item of items) {
        const key: any = callback(item, index);
        let group: any = groups.get(key);
        if (group === undefined) {
            group = [];
            groups.set(key, group);
        }
        group.push(item);
        index = index + 1;
    }
    return groups;
}

// `Error.prototype.toString.call(value)`: the generic ToString of any object
// with `name` / `message` properties (spec 20.5.3.4).
function __zunErrorProtoToString(value: any): string {
    const rawName: any = value.name;
    const rawMessage: any = value.message;
    const name: string = rawName === undefined ? "Error" : String(rawName);
    const message: string = rawMessage === undefined ? "" : String(rawMessage);
    if (name === "") {
        return message;
    }
    if (message === "") {
        return name;
    }
    return name + ": " + message;
}

// `new Array(...args)` / `Array(...args)` with a runtime argument list: a single
// number is a length (RangeError unless a valid array length); anything else
// is the element list.
function __zunArrayCtor(args: any[]): any[] {
    if (args.length === 1 && typeof args[0] === "number") {
        const length: number = args[0];
        if (length < 0 || length !== Math.floor(length) || length > 4294967295) {
            throw new RangeError("Invalid array length");
        }
        const out: any[] = [];
        out.length = length;
        return out;
    }
    // Copy by index (not `args.slice()`): a program may declare its own `Array`
    // class, which would shadow the method lookup here.
    const copy: any[] = [];
    copy.length = args.length;
    for (let i = 0; i < args.length; i++) {
        copy[i] = args[i];
    }
    return copy;
}

// `"".concat(...args)` / `String.prototype.concat.apply(s, args)`: each argument
// goes through ToString (a Symbol throws) and is appended left to right.
function __zunStringConcatArgs(base: string, args: any[]): string {
    let result: string = base;
    for (let i = 0; i < args.length; i++) {
        result = result + `${args[i]}`;
    }
    return result;
}

// ES2025 Set methods (union, intersection, ...). `o` is the receiver's native
// Set data; `other` is the set-like argument whose `size`, `has` and `keys`
// members are read once, in that order (GetSetRecord), and then driven exactly
// as the specification dictates.
function __zunSetLikeHas(other: any, hasFn: any, native: boolean, value: any): boolean {
    if (native) {
        return other.has(value) ? true : false;
    }
    return hasFn.call(other, value) ? true : false;
}

function __zunSetLikeKeys(other: any, keysFn: any, native: boolean): any {
    const iter: any = native ? other.keys() : keysFn.call(other);
    if (iter === null || iter === undefined || (typeof iter !== "object" && typeof iter !== "function")) {
        throw new TypeError("keys() result is not an object");
    }
    return iter;
}

function __zunIterNext(iter: any, nextFn: any, native: boolean): any {
    return native ? iter.next() : nextFn.call(iter);
}

function __zunIterClose(iter: any, native: boolean): void {
    if (native) {
        return;
    }
    const ret: any = iter.return;
    if (ret !== undefined && ret !== null) {
        ret.call(iter);
    }
}

function __zunSetOp(o: Set<any>, op: string, other: any): any {
    if (other === null || other === undefined || (typeof other !== "object" && typeof other !== "function")) {
        throw new TypeError("The \"other\" argument must be set-like");
    }
    const rawSize: any = other.size;
    if (typeof rawSize === "bigint") {
        throw new TypeError("Cannot convert a BigInt value to a number");
    }
    const numSize: number = Number(rawSize);
    if (numSize !== numSize) {
        throw new TypeError("The 'size' property must be a number");
    }
    const otherSize: number = numSize === Infinity || numSize === -Infinity ? numSize : Math.trunc(numSize);
    if (otherSize < 0) {
        throw new RangeError("'" + String(otherSize) + "' is an invalid size");
    }
    // Native Set / Map arguments answer `has` / `keys` through the dynamic
    // collection dispatch (they carry no function-valued properties).
    const native: boolean = other instanceof Set || other instanceof Map;
    let hasFn: any = undefined;
    let keysFn: any = undefined;
    if (!native) {
        hasFn = other.has;
        if (typeof hasFn !== "function") {
            throw new TypeError("The 'has' property must be a function");
        }
        keysFn = other.keys;
        if (typeof keysFn !== "function") {
            throw new TypeError("The 'keys' property must be a function");
        }
    }
    const thisSize: number = Number(o.size);
    const result = new Set<any>();
    if (op === "union" || op === "symmetricDifference") {
        const iter: any = __zunSetLikeKeys(other, keysFn, native);
        const nextFn: any = native ? undefined : iter.next;
        for (const v of o) {
            result.add(v);
        }
        while (true) {
            const step: any = __zunIterNext(iter, nextFn, native);
            if (step === null || step === undefined || (typeof step !== "object" && typeof step !== "function")) {
                throw new TypeError("Iterator result is not an object");
            }
            if (step.done) {
                break;
            }
            const value: any = step.value === 0 ? 0 : step.value;
            if (op === "union") {
                result.add(value);
            } else if (o.has(value)) {
                result.delete(value);
            } else {
                result.add(value);
            }
        }
        return result;
    }
    if (op === "isSupersetOf") {
        if (thisSize < otherSize) {
            return false;
        }
        const iter: any = __zunSetLikeKeys(other, keysFn, native);
        const nextFn: any = native ? undefined : iter.next;
        while (true) {
            const step: any = __zunIterNext(iter, nextFn, native);
            if (step === null || step === undefined || (typeof step !== "object" && typeof step !== "function")) {
                throw new TypeError("Iterator result is not an object");
            }
            if (step.done) {
                return true;
            }
            if (!o.has(step.value)) {
                __zunIterClose(iter, native);
                return false;
            }
        }
    }
    if (op === "isSubsetOf") {
        if (thisSize > otherSize) {
            return false;
        }
        const snapshot: any[] = [...o];
        for (const e of snapshot) {
            if (!__zunSetLikeHas(other, hasFn, native, e)) {
                return false;
            }
        }
        return true;
    }
    // intersection, difference, isDisjointFrom: walk the smaller side.
    if (op === "difference") {
        for (const v of o) {
            result.add(v);
        }
    }
    if (thisSize <= otherSize) {
        const snapshot: any[] = [...o];
        for (const e of snapshot) {
            const inOther: boolean = __zunSetLikeHas(other, hasFn, native, e) ? true : false;
            if (op === "isDisjointFrom") {
                if (inOther) {
                    return false;
                }
            } else if (op === "intersection") {
                if (inOther) {
                    result.add(e);
                }
            } else if (inOther) {
                result.delete(e);
            }
        }
    } else {
        const iter: any = __zunSetLikeKeys(other, keysFn, native);
        const nextFn: any = native ? undefined : iter.next;
        while (true) {
            const step: any = __zunIterNext(iter, nextFn, native);
            if (step === null || step === undefined || (typeof step !== "object" && typeof step !== "function")) {
                throw new TypeError("Iterator result is not an object");
            }
            if (step.done) {
                break;
            }
            const value: any = step.value === 0 ? 0 : step.value;
            if (op === "isDisjointFrom") {
                if (o.has(value)) {
                    __zunIterClose(iter, native);
                    return false;
                }
            } else if (op === "intersection") {
                if (o.has(value)) {
                    result.add(value);
                }
            } else {
                result.delete(value);
            }
        }
    }
    if (op === "isDisjointFrom") {
        return true;
    }
    return result;
}

function __zunSetOpSet(o: Set<any>, op: string, other: any): Set<any> {
    const result: Set<any> = __zunSetOp(o, op, other);
    return result;
}

function __zunSetOpBool(o: Set<any>, op: string, other: any): boolean {
    const result: boolean = __zunSetOp(o, op, other);
    return result;
}
