// Nucleus `TextDecoder` (WinterCG minimum common API, prelude class).
//
//   new TextDecoder(label?, { fatal, ignoreBOM }?)
//   encoding, fatal, ignoreBOM, decode(input?, { stream }?) -> string
//
// Supported encodings: utf-8, utf-16le, utf-16be and the windows-1252 family
// (decoded as latin1). Other labels from the Encoding Standard are accepted by
// the constructor but decode as UTF-8. Deferred: streaming state across
// calls (`stream: true` is accepted and ignored).

import { nodeBuffer as decBuffer } from "zun:core";

class TextDecoder {
    enc: string;
    fatalFlag: boolean;
    bomFlag: boolean;
    pend: any;

    constructor(label: any = undefined, options: any = null) {
        let name: string = "utf-8";
        if (label !== undefined) {
            name = TextDecoder.canonical(String(label));
            if (name == "") {
                throw new RangeError("The encoding label provided is invalid.");
            }
        }
        this.enc = name;
        this.fatalFlag = false;
        this.bomFlag = false;
        this.pend = [];
        if (options !== null && options !== undefined) {
            this.fatalFlag = options.fatal ? true : false;
            this.bomFlag = options.ignoreBOM ? true : false;
        }
    }

    get encoding(): string {
        return this.enc;
    }

    get fatal(): boolean {
        return this.fatalFlag;
    }

    get ignoreBOM(): boolean {
        return this.bomFlag;
    }

    // Maps a label to its canonical encoding name ("" when unmapped).
    static canonical(raw: string): string {
        const l: string = raw.replace(/^[ \t\n\f\r]+|[ \t\n\f\r]+$/g, "").toLowerCase();
        if (l == "utf-8" || l == "utf8" || l == "unicode-1-1-utf-8" || l == "unicode11utf8" || l == "unicode20utf8" || l == "x-unicode20utf8") {
            return "utf-8";
        }
        if (l == "utf-16le" || l == "utf-16" || l == "ucs-2" || l == "unicode" || l == "csunicode" || l == "iso-10646-ucs-2" || l == "unicodefeff") {
            return "utf-16le";
        }
        if (l == "utf-16be" || l == "unicodefffe") {
            return "utf-16be";
        }
        if (l == "windows-1252" || l == "latin1" || l == "iso-8859-1" || l == "iso8859-1" || l == "ascii" || l == "us-ascii" || l == "cp1252" || l == "ansi_x3.4-1968" || l == "l1" || l == "iso_8859-1" || l == "x-cp1252") {
            return "windows-1252";
        }
        if (l == "big5" || l == "gbk" || l == "gb18030" || l == "shift_jis" || l == "sjis" || l == "euc-jp" || l == "euc-kr" || l == "iso-2022-jp" || l == "iso-8859-2" || l == "koi8-r" || l == "windows-1251" || l == "gb2312") {
            return l;
        }
        return "";
    }

    decode(input: any = undefined, options: any = null): string {
        let bytes: any = new Uint8Array(0);
        if (input !== undefined && input !== null) {
            if (input.buffer !== undefined) {
                bytes = new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
            } else if (input.byteLength !== undefined) {
                bytes = new Uint8Array(input);
            } else {
                throw new TypeError("The provided value is not of type ArrayBuffer or ArrayBufferView.");
            }
        }
        if (this.enc == "utf-16le" || this.enc == "utf-16be") {
            return this.decode16(bytes);
        }
        if (this.enc == "windows-1252") {
            return decBuffer.nodeBufferToString(bytes, "latin1", 0, bytes.length);
        }
        // UTF-8 streaming: an incomplete trailing sequence is held for the next call.
        const stream: boolean = options !== null && options !== undefined && options.stream ? true : false;
        if (this.pend.length > 0) {
            const joined: any = new Uint8Array(this.pend.length + bytes.length);
            for (let k = 0; k < this.pend.length; k++) {
                joined[k] = this.pend[k];
            }
            for (let k = 0; k < bytes.length; k++) {
                joined[this.pend.length + k] = bytes[k];
            }
            bytes = joined;
            this.pend = [];
        }
        if (stream) {
            const n: number = bytes.length;
            let cut: number = n;
            for (let back = 1; back <= 3 && back <= n; back++) {
                const b: number = bytes[n - back];
                if (b >= 192) {
                    const need: number = b >= 240 ? 4 : (b >= 224 ? 3 : 2);
                    if (need > back && b < 248) {
                        cut = n - back;
                    }
                    break;
                }
                if (b < 128) {
                    break;
                }
            }
            if (cut < n) {
                const held: any = [];
                for (let k = cut; k < n; k++) {
                    held.push(bytes[k]);
                }
                this.pend = held;
                bytes = new Uint8Array(bytes.buffer, bytes.byteOffset, cut);
            }
        }
        let start: u64 = 0;
        if (!this.bomFlag && bytes.length >= 3 && bytes[0] == 239 && bytes[1] == 187 && bytes[2] == 191) {
            start = 3;
        }
        const text: string = decBuffer.nodeBufferToString(bytes, "utf8", start, bytes.length);
        if (this.fatalFlag && text.indexOf("�") >= 0) {
            // Lossy decoding changes the byte length of malformed input; a valid
            // input round-trips to the same number of bytes.
            const back: any = decBuffer.nodeBufferFromString(text, "utf8");
            if (back.length != bytes.length - start) {
                throw new TypeError("The encoded data was not valid for encoding utf-8");
            }
        }
        return text;
    }

    decode16(bytes: any): string {
        const le: boolean = this.enc == "utf-16le";
        let out: string = "";
        let i: number = 0;
        const n: number = bytes.length - (bytes.length % 2);
        let first: boolean = true;
        while (i < n) {
            const u: number = le ? (bytes[i] | (bytes[i + 1] << 8)) : ((bytes[i] << 8) | bytes[i + 1]);
            i = i + 2;
            if (first) {
                first = false;
                if (!this.bomFlag && u == 65279) {
                    continue;
                }
            }
            if (u >= 55296 && u <= 56319) {
                let ok: boolean = false;
                if (i < n) {
                    const v: number = le ? (bytes[i] | (bytes[i + 1] << 8)) : ((bytes[i] << 8) | bytes[i + 1]);
                    if (v >= 56320 && v <= 57343) {
                        out = out + String.fromCharCode(u) + String.fromCharCode(v);
                        i = i + 2;
                        ok = true;
                    }
                }
                if (!ok) {
                    if (this.fatalFlag) {
                        throw new TypeError("The encoded data was not valid for encoding " + this.enc);
                    }
                    out = out + "�";
                }
            } else if (u >= 56320 && u <= 57343) {
                if (this.fatalFlag) {
                    throw new TypeError("The encoded data was not valid for encoding " + this.enc);
                }
                out = out + "�";
            } else {
                out = out + String.fromCharCode(u);
            }
        }
        if (bytes.length % 2 == 1) {
            if (this.fatalFlag) {
                throw new TypeError("The encoded data was not valid for encoding " + this.enc);
            }
            out = out + "�";
        }
        return out;
    }
}
