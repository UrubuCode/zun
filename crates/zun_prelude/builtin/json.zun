// Nucleus `JSON` text surface (prelude class, compiled with every program).
//
//   JSON.stringify(value)  -> string
//   JSON.parse(text)       -> any
//
// Deferred for v1 (documented, not defects):
//   * `stringify`'s `replacer` and `space` (indentation) arguments.
//   * `toJSON` hooks on values.
//   * `parse`'s `reviver` argument.
//   * `stringify(undefined)` returns the string "undefined" (JS returns the
//     `undefined` value; the return type here is `string`).
//
// Failure contract: malformed text makes `JSON.parse` throw a `SyntaxError`
// (catchable with `catch (e: SyntaxError)`); a self-referential value makes
// `JSON.stringify` throw a `TypeError`.
//
// Self-contained over the `zun:core` native surface (string/number/object/array
// namespaces); it calls no String/Number/Array methods, so it compiles as a
// prelude class. Dialect notes: indices are `u64`, char codes are
// `u32`, numbers are `f64`, there is no `else if`, and an `any` value cannot be
// stored into an object field by variable, so objects are assembled through
// `Object.fromEntries` from `[key, value]` pairs.

import { string as coreString, number as coreNumber, object as coreObject, array as coreArray } from "zun:core";

class JSON {
    // --- stringify ---------------------------------------------------------

    static stringify(value: any, replacer: any = null, space: any = null): any {
        return coreObject.jsonStringify(value, replacer, space);
    }

    // Nesting limit; deeper (or cyclic) input is rejected instead of overflowing
    // the stack.
    static maxDepth(): u64 {
        return 512;
    }

    static write(value: any, depth: u64): string {
        if (depth > JSON.maxDepth()) {
            throw new TypeError("Converting circular structure to JSON");
        }
        let kind = typeof value;
        if (kind == "string") {
            return JSON.quote(value as string);
        }
        if (kind == "number") {
            let n = value as number;
            // NaN and +/-Infinity are not JSON numbers; `n - n` is 0 only for
            // finite `n`.
            if (n - n != 0.0) {
                return "null";
            }
            return coreNumber.toString(n);
        }
        if (kind == "boolean") {
            if (value as boolean) {
                return "true";
            }
            return "false";
        }
        if (kind == "undefined") {
            return "undefined";
        }
        if (value == null) {
            return "null";
        }
        // Primitive wrapper objects serialize as the primitive they wrap.
        if (value instanceof NumberObject) {
            let wrapped = value as NumberObject;
            return JSON.write(wrapped.value, depth + 1);
        }
        if (value instanceof BooleanObject) {
            let wrappedFlag = value as BooleanObject;
            return JSON.write(wrappedFlag.value, depth + 1);
        }
        if (coreArray.arrayIsArray(value)) {
            let items = value as Array;
            let n: u64 = items.length;
            let out = "[";
            let i: u64 = 0;
            while (i < n) {
                if (i > 0) {
                    out = out + ",";
                }
                let item: any = items[i];
                if (JSON.isSkipped(item)) {
                    // JSON.stringify renders undefined array slots as null.
                    out = out + "null";
                } else {
                    out = out + JSON.write(item, depth + 1);
                }
                i = i + 1;
            }
            return out + "]";
        }
        // `Object.entries` yields [key, value] pairs, so no dynamic property load is needed.
        let entries = coreObject.entries(value);
        let n: u64 = entries.length;
        let out = "{";
        let first = true;
        let i: u64 = 0;
        while (i < n) {
            let pair = entries[i] as Array;
            let key = pair[0] as string;
            let item: any = pair[1];
            // Properties holding undefined are omitted, as in JSON.stringify.
            if (!JSON.isSkipped(item)) {
                if (!first) {
                    out = out + ",";
                }
                first = false;
                out = out + JSON.quote(key) + ":" + JSON.write(item, depth + 1);
            }
            i = i + 1;
        }
        return out + "}";
    }

    // True for values JSON cannot represent (undefined; functions cannot be held
    // in an `any`).
    static isSkipped(item: any): boolean {
        return typeof item == "undefined";
    }

    static quote(s: string): string {
        let out = "\"";
        let n: u64 = coreString.length(s);
        let i: u64 = 0;
        while (i < n) {
            let c: u32 = coreString.charCodeAt(s, i);
            if (c == 34) {
                out = out + "\\\"";
            } else {
                if (c == 92) {
                    out = out + "\\\\";
                } else {
                    if (c < 32) {
                        out = out + JSON.escapeControl(c);
                    } else {
                        out = out + coreString.substring(s, i, i + 1);
                    }
                }
            }
            i = i + 1;
        }
        return out + "\"";
    }

    static escapeControl(c: u32): string {
        if (c == 10) {
            return "\\n";
        }
        if (c == 13) {
            return "\\r";
        }
        if (c == 9) {
            return "\\t";
        }
        if (c == 8) {
            return "\\b";
        }
        if (c == 12) {
            return "\\f";
        }
        return "\\u00" + JSON.hexDigit(c / 16) + JSON.hexDigit(c % 16);
    }

    static hexDigit(d: u32): string {
        let digits = "0123456789abcdef";
        let at = d as u64;
        return coreString.substring(digits, at, at + 1);
    }

    // --- parse -------------------------------------------------------------

    static parse(text: any): any {
        let parser = new JsonParser(String(text));
        return parser.parseDocument();
    }
}

// Recursive-descent parser state. `pos` is a UTF-16 code unit index.
class JsonParser {
    src: string;
    pos: u64 = 0;

    fail(what: string): void {
        if (this.pos >= coreString.length(this.src)) {
            throw new SyntaxError(what + " (unexpected end of JSON input)");
        }
        throw new SyntaxError(what + " in JSON at position " + coreNumber.toString(this.pos as number));
    }

    // Code unit at `pos`, or 0 at end of input (0 is never valid JSON text).
    peek(): u32 {
        if (this.pos >= coreString.length(this.src)) {
            return 0;
        }
        return coreString.charCodeAt(this.src, this.pos);
    }

    // Space, tab, newline, carriage return. `peek()` yields 0 at end of input.
    isWhitespace(c: u32): boolean {
        if (c == 32) {
            return true;
        }
        if (c == 9) {
            return true;
        }
        if (c == 10) {
            return true;
        }
        return c == 13;
    }

    parseDocument(): any {
        this.skipWhitespace();
        let result: any = this.parseValue(0);
        this.skipWhitespace();
        if (this.pos < coreString.length(this.src)) {
            this.fail("Unexpected token");
        }
        return result;
    }

    skipWhitespace(): void {
        while (this.isWhitespace(this.peek())) {
            this.pos = this.pos + 1;
        }
    }

    parseValue(depth: u64): any {
        if (depth > JSON.maxDepth()) {
            this.fail("Nesting too deep");
        }
        let c: u32 = this.peek();
        if (c == 123) {
            return this.parseObject(depth);
        }
        if (c == 91) {
            return this.parseArray(depth);
        }
        if (c == 34) {
            let s: any = this.parseString();
            return s;
        }
        if (c == 116) {
            this.expectWord("true");
            return true;
        }
        if (c == 102) {
            this.expectWord("false");
            return false;
        }
        if (c == 110) {
            this.expectWord("null");
            return null;
        }
        if (c == 45) {
            return this.parseNumber();
        }
        if (this.isDigit(c)) {
            return this.parseNumber();
        }
        this.fail("Unexpected token");
        return null;
    }

    expectWord(word: string): void {
        let n: u64 = coreString.length(word);
        if (this.pos + n > coreString.length(this.src)) {
            this.pos = coreString.length(this.src);
            this.fail("Unexpected token");
        }
        if (coreString.substring(this.src, this.pos, this.pos + n) != word) {
            this.fail("Unexpected token");
        }
        this.pos = this.pos + n;
    }

    parseArray(depth: u64): any {
        this.pos = this.pos + 1;
        let items: Array = [];
        this.skipWhitespace();
        if (this.peek() == 93) {
            this.pos = this.pos + 1;
            return items;
        }
        while (true) {
            this.skipWhitespace();
            let item: any = this.parseValue(depth + 1);
            items.push(item);
            this.skipWhitespace();
            let c: u32 = this.peek();
            if (c == 44) {
                this.pos = this.pos + 1;
            } else {
                if (c == 93) {
                    this.pos = this.pos + 1;
                    return items;
                }
                this.fail("Expected ',' or ']' after array element");
            }
        }
        return items;
    }

    parseObject(depth: u64): any {
        this.pos = this.pos + 1;
        let entries: Array = [];
        this.skipWhitespace();
        if (this.peek() == 125) {
            this.pos = this.pos + 1;
            return coreObject.fromEntries(entries);
        }
        while (true) {
            this.skipWhitespace();
            if (this.peek() != 34) {
                this.fail("Expected a string key");
            }
            let key: any = this.parseString();
            this.skipWhitespace();
            if (this.peek() != 58) {
                this.fail("Expected ':' after object key");
            }
            this.pos = this.pos + 1;
            this.skipWhitespace();
            let item: any = this.parseValue(depth + 1);
            let pair: Array = [];
            pair.push(key);
            pair.push(item);
            entries.push(pair);
            this.skipWhitespace();
            let c: u32 = this.peek();
            if (c == 44) {
                this.pos = this.pos + 1;
            } else {
                if (c == 125) {
                    this.pos = this.pos + 1;
                    return coreObject.fromEntries(entries);
                }
                this.fail("Expected ',' or '}' after object member");
            }
        }
        return coreObject.fromEntries(entries);
    }

    // Parses a string literal starting at the opening quote.
    parseString(): string {
        this.pos = this.pos + 1;
        let out = "";
        let n: u64 = coreString.length(this.src);
        while (true) {
            if (this.pos >= n) {
                this.fail("Unterminated string");
            }
            let c: u32 = coreString.charCodeAt(this.src, this.pos);
            if (c == 34) {
                this.pos = this.pos + 1;
                return out;
            }
            if (c < 32) {
                this.fail("Bad control character in string literal");
            }
            if (c == 92) {
                this.pos = this.pos + 1;
                out = out + this.parseEscape();
            } else {
                out = out + coreString.substring(this.src, this.pos, this.pos + 1);
                this.pos = this.pos + 1;
            }
        }
        return out;
    }

    // Parses the character(s) after a backslash; `pos` is on the escape letter.
    parseEscape(): string {
        let c: u32 = this.peek();
        this.pos = this.pos + 1;
        if (c == 34) {
            return "\"";
        }
        if (c == 92) {
            return "\\";
        }
        if (c == 47) {
            return "/";
        }
        if (c == 98) {
            return coreString.fromCharCode1(8);
        }
        if (c == 102) {
            return coreString.fromCharCode1(12);
        }
        if (c == 110) {
            return coreString.fromCharCode1(10);
        }
        if (c == 114) {
            return coreString.fromCharCode1(13);
        }
        if (c == 116) {
            return coreString.fromCharCode1(9);
        }
        if (c == 117) {
            let code: u32 = 0;
            let k: u32 = 0;
            while (k < 4) {
                let h: u32 = this.hexValue(this.peek());
                code = code * 16 + h;
                this.pos = this.pos + 1;
                k = k + 1;
            }
            return coreString.fromCharCode1(code);
        }
        this.pos = this.pos - 1;
        this.fail("Bad escaped character");
        return "";
    }

    // Value of a hex digit code; fails (via the position check) on non-hex.
    hexValue(c: u32): u32 {
        if (c >= 48) {
            if (c <= 57) {
                return c - 48;
            }
        }
        if (c >= 97) {
            if (c <= 102) {
                return c - 87;
            }
        }
        if (c >= 65) {
            if (c <= 70) {
                return c - 55;
            }
        }
        this.fail("Bad Unicode escape");
        return 0;
    }

    isExponentMark(c: u32): boolean {
        if (c == 101) {
            return true;
        }
        return c == 69;
    }

    isDigit(c: u32): boolean {
        if (c < 48) {
            return false;
        }
        return c <= 57;
    }

    // Strict JSON number grammar: -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?
    parseNumber(): any {
        let start: u64 = this.pos;
        if (this.peek() == 45) {
            this.pos = this.pos + 1;
        }
        let c: u32 = this.peek();
        if (!this.isDigit(c)) {
            this.fail("No number after minus sign");
        }
        if (c == 48) {
            this.pos = this.pos + 1;
        } else {
            while (this.isDigit(this.peek())) {
                this.pos = this.pos + 1;
            }
        }
        if (this.peek() == 46) {
            this.pos = this.pos + 1;
            if (!this.isDigit(this.peek())) {
                this.fail("Unterminated fractional number");
            }
            while (this.isDigit(this.peek())) {
                this.pos = this.pos + 1;
            }
        }
        let e: u32 = this.peek();
        if (this.isExponentMark(e)) {
            this.pos = this.pos + 1;
            let sign: u32 = this.peek();
            if (sign == 43) {
                this.pos = this.pos + 1;
            }
            if (sign == 45) {
                this.pos = this.pos + 1;
            }
            if (!this.isDigit(this.peek())) {
                this.fail("Exponent part is missing a number");
            }
            while (this.isDigit(this.peek())) {
                this.pos = this.pos + 1;
            }
        }
        let value: number = coreNumber.parseFloat(coreString.substring(this.src, start, this.pos));
        return value;
    }
}
