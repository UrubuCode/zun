// ECMAScript `Date` over an f64 time value.
//
// The instance state is one `number`, `t`: milliseconds since the epoch, with
// NaN standing for Invalid Date (every getter then answers NaN, `toString` is
// "Invalid Date", `toISOString` throws a RangeError). Values are clipped to
// +-8.64e15 ms at every point a time value is produced (`date.clip`).
//
// The constructor and the multi-argument members are rest-parameter members:
// ECMAScript distinguishes an omitted argument from an explicit `undefined`
// (`d.setUTCHours(1, undefined)` poisons the date, `d.setUTCHours(1)` does not)
// and ignores extra arguments, neither of which fixed positional parameters
// can express. The spec `length` of those members is folded at compile time in
// `zun_sema` (`date_function_length`).
//
// All calendar arithmetic (MakeDay/MakeTime/TimeClip, field extraction, ISO
// parsing and formatting) lives in the `zun:date` natives
// (`crates/zun_natives/src/date_f64.rs`). Local-time members convert at the
// method boundary through `date.localTime` / `date.utcFromLocal` (host zone,
// DST aware); the stored time value is always UTC.

import { date, time } from "zun:core";

class Date {
    t: number = 0;

    // `new Date()` (now), `new Date(number | string | Date)`, and
    // `new Date(year, month, ...)` (local time, years 0-99 mean 19xx).
    constructor(...args: any[]) {
        const n: number = args.length as number;
        if (n == 0) {
            this.t = time.nowMillis() as number;
        } else if (n == 1) {
            const v: any = args[0];
            if (v instanceof Date) {
                this.t = (v as Date).t;
            } else if (typeof v === "string") {
                this.t = date.parseDate(v as string);
            } else {
                this.t = date.clip(Number(v));
            }
        } else {
            const y: number = Number(args[0]);
            const mo: number = Number(args[1]);
            const d: number = n > 2 ? Number(args[2]) : 1;
            const h: number = n > 3 ? Number(args[3]) : 0;
            const mi: number = n > 4 ? Number(args[4]) : 0;
            const s: number = n > 5 ? Number(args[5]) : 0;
            const ms: number = n > 6 ? Number(args[6]) : 0;
            this.t = date.utcFromLocal(date.makeUtc(y, mo, d, h, mi, s, ms, true));
        }
    }

    setMillis(value: number): Date {
        this.t = date.clip(value);
        return this;
    }

    isValid(): boolean { return date.valid(this.t); }
    isBefore(other: Date): boolean { return this.t < other.t; }
    isAfter(other: Date): boolean { return this.t > other.t; }
    isEqual(other: Date): boolean { return this.t == other.t; }

    getTime(): number { return this.t; }
    valueOf(): number { return this.t; }
    setTime(...a: any[]): number {
        this.t = date.clip(a.length > 0 ? Number(a[0]) : NaN);
        return this.t;
    }

    // Calendar accessors (1-based month, ISO weekday); the date must be valid.
    utcYear(): i32 { return date.field(this.t, 0) as i32; }
    utcMonth(): i32 { return (date.field(this.t, 1) + 1) as i32; }
    utcDay(): i32 { return date.field(this.t, 2) as i32; }
    utcHour(): i32 { return date.field(this.t, 3) as i32; }
    utcMinute(): i32 { return date.field(this.t, 4) as i32; }
    utcSecond(): i32 { return date.field(this.t, 5) as i32; }
    utcMillisecond(): i32 { return date.field(this.t, 6) as i32; }
    utcWeekday(): i32 {
        const w: i32 = date.field(this.t, 7) as i32;
        if (w == 0) { return 7; }
        return w;
    }
    utcDayOfYear(): i32 { return date.dayOfYear(this.t as i64); }
    isoDate(): string { return this.toISOString().slice(0, 10); }
    isoDateTime(): string { return this.toISOString(); }

    getUTCFullYear(): number { return date.field(this.t, 0); }
    getUTCMonth(): number { return date.field(this.t, 1); }
    getUTCDate(): number { return date.field(this.t, 2); }
    getUTCHours(): number { return date.field(this.t, 3); }
    getUTCMinutes(): number { return date.field(this.t, 4); }
    getUTCSeconds(): number { return date.field(this.t, 5); }
    getUTCMilliseconds(): number { return date.field(this.t, 6); }
    getUTCDay(): number { return date.field(this.t, 7); }
    getUTCWeekday(): i32 { return this.utcWeekday(); }
    getUTCDayOfYear(): i32 { return this.utcDayOfYear(); }

    getTimezoneOffset(): number { return date.tzOffset(this.t); }

    getFullYear(): number { return date.field(date.localTime(this.t), 0); }
    getMonth(): number { return date.field(date.localTime(this.t), 1); }
    getDate(): number { return date.field(date.localTime(this.t), 2); }
    getDay(): number { return date.field(date.localTime(this.t), 7); }
    getHours(): number { return date.field(date.localTime(this.t), 3); }
    getMinutes(): number { return date.field(date.localTime(this.t), 4); }
    getSeconds(): number { return date.field(date.localTime(this.t), 5); }
    getMilliseconds(): number { return date.field(date.localTime(this.t), 6); }

    // Shared setter core: replace up to `max` fields starting at field `start`
    // (0 year, 1 month, 2 date, 3 hours, 4 minutes, 5 seconds, 6 ms) with the
    // supplied arguments. No arguments at all means the first value is
    // `undefined`, i.e. NaN. Extra arguments are ignored.
    applyFields(start: number, max: number, a: any[], local: boolean): number {
        let n: number = a.length as number;
        let v0: number = NaN;
        if (n > max) {
            n = max;
        }
        if (n == 0) {
            n = 1;
        } else {
            v0 = Number(a[0]);
        }
        const v1: number = n > 1 ? Number(a[1]) : 0;
        const v2: number = n > 2 ? Number(a[2]) : 0;
        const v3: number = n > 3 ? Number(a[3]) : 0;
        if (local) {
            const r: number = date.setFields(date.localTime(this.t), start, n, v0, v1, v2, v3);
            this.t = date.utcFromLocal(r);
        } else {
            this.t = date.setFields(this.t, start, n, v0, v1, v2, v3);
        }
        return this.t;
    }

    setUTCFullYear(...a: any[]): number { return this.applyFields(0, 3, a, false); }
    setUTCMonth(...a: any[]): number { return this.applyFields(1, 2, a, false); }
    setUTCDate(...a: any[]): number { return this.applyFields(2, 1, a, false); }
    setUTCHours(...a: any[]): number { return this.applyFields(3, 4, a, false); }
    setUTCMinutes(...a: any[]): number { return this.applyFields(4, 3, a, false); }
    setUTCSeconds(...a: any[]): number { return this.applyFields(5, 2, a, false); }
    setUTCMilliseconds(...a: any[]): number { return this.applyFields(6, 1, a, false); }

    setFullYear(...a: any[]): number { return this.applyFields(0, 3, a, true); }
    setMonth(...a: any[]): number { return this.applyFields(1, 2, a, true); }
    setDate(...a: any[]): number { return this.applyFields(2, 1, a, true); }
    setHours(...a: any[]): number { return this.applyFields(3, 4, a, true); }
    setMinutes(...a: any[]): number { return this.applyFields(4, 3, a, true); }
    setSeconds(...a: any[]): number { return this.applyFields(5, 2, a, true); }
    setMilliseconds(...a: any[]): number { return this.applyFields(6, 1, a, true); }

    toLocaleString(locale: string = ""): string {
        if (!date.valid(this.t)) { return "Invalid Date"; }
        return date.dateToLocaleString(this.t, locale);
    }
    toLocaleDateString(locale: string = ""): string {
        if (!date.valid(this.t)) { return "Invalid Date"; }
        return date.dateToLocaleDateString(this.t, locale);
    }
    toLocaleTimeString(locale: string = ""): string {
        if (!date.valid(this.t)) { return "Invalid Date"; }
        return date.dateToLocaleTimeString(this.t, locale);
    }

    toISOString(): string {
        if (!date.valid(this.t)) {
            throw new RangeError("Invalid time value");
        }
        return date.isoString(this.t);
    }
    toJSON(): any {
        if (!date.valid(this.t)) { return null; }
        return date.isoString(this.t);
    }
    toUTCString(): string {
        if (!date.valid(this.t)) { return "Invalid Date"; }
        return date.utcString(this.t);
    }
    toString(): string {
        if (!date.valid(this.t)) { return "Invalid Date"; }
        return date.dateString(this.t, 0);
    }
    toDateString(): string {
        if (!date.valid(this.t)) { return "Invalid Date"; }
        return date.dateString(this.t, 1);
    }
    toTimeString(): string {
        if (!date.valid(this.t)) { return "Invalid Date"; }
        return date.dateString(this.t, 2);
    }

    // The "number" hint yields the time value; "string" and "default" yield
    // the string form (so `date + ""` concatenates and `date - 0` subtracts).
    [Symbol.toPrimitive](hint: any): any {
        if (hint === "number") {
            return this.t;
        }
        if (hint === "string" || hint === "default") {
            return this.toString();
        }
        throw new TypeError("Invalid hint: " + String(hint));
    }

    // JS statics. `now` and `parse` return a time value rather than a `Date`,
    // as they do in JS; the object-returning forms are named separately.
    static now(): number { return time.nowMillis() as number; }
    static parse(value: string): number { return date.parseDate(value); }
    static fromMillis(value: number): Date { return new Date(value); }
    static fromISO(value: string): Date { return new Date(date.parseDate(value)); }
    static fromISODate(value: string): Date { return new Date(date.parseDate(value)); }
    // `Date.UTC(year, month?, ...)` takes a 0-based month; years 0-99 mean 19xx.
    // Static members cannot take a rest parameter, so the optional arguments
    // are `any` and an `undefined` slot means "omitted".
    static UTC(year?: any, month?: any, day?: any, hour?: any, minute?: any, second?: any, milli?: any): number {
        if (year === undefined) {
            return NaN;
        }
        const mo: number = month === undefined ? 0 : Number(month);
        const d: number = day === undefined ? 1 : Number(day);
        const h: number = hour === undefined ? 0 : Number(hour);
        const mi: number = minute === undefined ? 0 : Number(minute);
        const s: number = second === undefined ? 0 : Number(second);
        const ms: number = milli === undefined ? 0 : Number(milli);
        return date.makeUtc(Number(year), mo, d, h, mi, s, ms, true);
    }
}
