// `URLSearchParams` (WHATWG URL, prelude class).
//
//   new URLSearchParams(init?)   init: query string (leading "?" optional), an
//                                array of pairs, a Map, a record, or another
//                                URLSearchParams
//   get / getAll / has / append / set / delete / sort / forEach / keys /
//   values / entries / size / toString / [Symbol.iterator]
//
// A `URLSearchParams` obtained from `URL.searchParams` is linked back to its
// URL (`owner`): mutations rewrite the URL's query, and `URL.search` writes
// refresh the list. Serialization follows application/x-www-form-urlencoded:
// space -> "+", bytes outside [A-Za-z0-9*-._] -> %XX over the UTF-8 encoding.
//
// Self-contained over the `zun:core` native surface (string + nodeBuffer).

import { string as upString, nodeBuffer as upBuffer } from "zun:core";

class URLSearchParams {
    ks: any = [];
    vs: any = [];
    owner: any = null;

    constructor(init?: any) {
        if (init === undefined) {
            return;
        }
        if (typeof init === "string") {
            this.parseQuery(init);
            return;
        }
        if (init !== null && typeof init === "object") {
            if (init instanceof URLSearchParams) {
                const other: any = init;
                for (let i = 0; i < other.ks.length; i++) {
                    this.ks.push(other.ks[i]);
                    this.vs.push(other.vs[i]);
                }
                return;
            }
            const probe: any = init;
            if (Array.isArray(probe) || probe instanceof Map || typeof probe[Symbol.iterator] === "function") {
                for (const item of probe) {
                    const pair: any = [];
                    for (const part of item) {
                        pair.push(part);
                    }
                    if (pair.length !== 2) {
                        throw new TypeError("Each URLSearchParams pair must have exactly two items");
                    }
                    this.ks.push(String(pair[0]));
                    this.vs.push(String(pair[1]));
                }
                return;
            }
            const keys = Object.keys(probe);
            for (let i = 0; i < keys.length; i++) {
                this.ks.push(keys[i]);
                this.vs.push(String(probe[keys[i]]));
            }
            return;
        }
        this.parseQuery(String(init));
    }

    // Replaces the list with the pairs parsed from `query`.
    parseQuery(query: string): void {
        this.ks = [];
        this.vs = [];
        let start = 0;
        if (query.length > 0 && query.charAt(0) == "?") {
            start = 1;
        }
        const parts = query.substring(start).split("&");
        for (let i = 0; i < parts.length; i++) {
            const part: string = parts[i];
            if (part.length == 0) {
                continue;
            }
            const eq = part.indexOf("=");
            if (eq < 0) {
                this.ks.push(URLSearchParams.decode(part));
                this.vs.push("");
            } else {
                this.ks.push(URLSearchParams.decode(part.substring(0, eq)));
                this.vs.push(URLSearchParams.decode(part.substring(eq + 1)));
            }
        }
    }

    // Pushes the serialized list back into the owning URL, if any.
    changed(): void {
        if (this.owner !== null) {
            this.owner.queryFromParams(this.toString());
        }
    }

    // --- percent coding ----------------------------------------------------

    static hexValue(c: u32): u32 {
        if (c >= 48) {
            if (c <= 57) {
                return c - 48;
            }
        }
        if (c >= 97) {
            if (c <= 102) {
                return c - 87;
            }
        }
        if (c >= 65) {
            if (c <= 70) {
                return c - 55;
            }
        }
        return 256;
    }

    static hexDigit(d: u32): string {
        let digits = "0123456789ABCDEF";
        let at = d as u64;
        return upString.substring(digits, at, at + 1);
    }

    // Percent-decodes `s`, mapping "+" to a space; malformed escapes stay literal.
    static decode(s: string): string {
        let bytes = upBuffer.nodeBufferFromString(s, "utf8");
        let n: u64 = bytes.length;
        let out = upBuffer.nodeBufferAlloc(n, 0);
        let count: u64 = 0;
        let i: u64 = 0;
        while (i < n) {
            let b: u32 = bytes[i] as u32;
            if (b == 43) {
                out[count] = 32 as u8;
                i = i + 1;
            } else {
                let handled = false;
                if (b == 37) {
                    if (i + 2 < n) {
                        let hi: u32 = URLSearchParams.hexValue(bytes[i + 1] as u32);
                        let lo: u32 = URLSearchParams.hexValue(bytes[i + 2] as u32);
                        if (hi < 16) {
                            if (lo < 16) {
                                out[count] = (hi * 16 + lo) as u8;
                                i = i + 3;
                                handled = true;
                            }
                        }
                    }
                }
                if (!handled) {
                    out[count] = b as u8;
                    i = i + 1;
                }
            }
            count = count + 1;
        }
        return upBuffer.nodeBufferToString(out, "utf8", 0, count);
    }

    static isUnreserved(b: u32): boolean {
        if (b >= 97) {
            if (b <= 122) {
                return true;
            }
        }
        if (b >= 65) {
            if (b <= 90) {
                return true;
            }
        }
        if (b >= 48) {
            if (b <= 57) {
                return true;
            }
        }
        if (b == 42) {
            return true;
        }
        if (b == 45) {
            return true;
        }
        if (b == 46) {
            return true;
        }
        return b == 95;
    }

    // application/x-www-form-urlencoded byte serializer.
    static encode(s: string): string {
        let bytes = upBuffer.nodeBufferFromString(s, "utf8");
        let n: u64 = bytes.length;
        let out = "";
        let i: u64 = 0;
        while (i < n) {
            let b: u32 = bytes[i] as u32;
            if (b == 32) {
                out = out + "+";
            } else {
                if (URLSearchParams.isUnreserved(b)) {
                    out = out + upString.fromCharCode1(b);
                } else {
                    out = out + "%" + URLSearchParams.hexDigit(b / 16) + URLSearchParams.hexDigit(b % 16);
                }
            }
            i = i + 1;
        }
        return out;
    }

    // --- API ---------------------------------------------------------------

    get size(): number {
        return this.ks.length;
    }

    get(name: any): any {
        const key = String(name);
        for (let i = 0; i < this.ks.length; i++) {
            if (this.ks[i] == key) {
                return this.vs[i];
            }
        }
        return null;
    }

    getAll(name: any): any {
        const key = String(name);
        const found: any = [];
        for (let i = 0; i < this.ks.length; i++) {
            if (this.ks[i] == key) {
                found.push(this.vs[i]);
            }
        }
        return found;
    }

    has(name: any, value?: any): boolean {
        const key = String(name);
        for (let i = 0; i < this.ks.length; i++) {
            if (this.ks[i] == key) {
                if (value === undefined || this.vs[i] == String(value)) {
                    return true;
                }
            }
        }
        return false;
    }

    append(name: any, value: any): void {
        this.ks.push(String(name));
        this.vs.push(String(value));
        this.changed();
    }

    // Removes every pair named `name` (with the given value, when supplied).
    delete(name: any, value?: any): void {
        const key = String(name);
        const names: any = [];
        const values: any = [];
        for (let i = 0; i < this.ks.length; i++) {
            let drop = this.ks[i] == key;
            if (drop && value !== undefined) {
                drop = this.vs[i] == String(value);
            }
            if (!drop) {
                names.push(this.ks[i]);
                values.push(this.vs[i]);
            }
        }
        this.ks = names;
        this.vs = values;
        this.changed();
    }

    // Replaces the first pair named `name` (dropping the rest), or appends.
    set(name: any, value: any): void {
        const key = String(name);
        const text = String(value);
        const names: any = [];
        const values: any = [];
        let placed = false;
        for (let i = 0; i < this.ks.length; i++) {
            if (this.ks[i] == key) {
                if (!placed) {
                    names.push(key);
                    values.push(text);
                    placed = true;
                }
            } else {
                names.push(this.ks[i]);
                values.push(this.vs[i]);
            }
        }
        if (!placed) {
            names.push(key);
            values.push(text);
        }
        this.ks = names;
        this.vs = values;
        this.changed();
    }

    // Stable sort by name, comparing UTF-16 code units.
    sort(): void {
        for (let i = 1; i < this.ks.length; i++) {
            const n = this.ks[i];
            const v = this.vs[i];
            let j = i - 1;
            while (j >= 0 && this.ks[j] > n) {
                this.ks[j + 1] = this.ks[j];
                this.vs[j + 1] = this.vs[j];
                j = j - 1;
            }
            this.ks[j + 1] = n;
            this.vs[j + 1] = v;
        }
        this.changed();
    }

    forEach(callback: any, thisArg?: any): void {
        if (typeof callback !== "function") {
            throw new TypeError("The callback provided as parameter 1 is not a function");
        }
        for (let i = 0; i < this.ks.length; i++) {
            callback.call(thisArg, this.vs[i], this.ks[i], this);
        }
    }

    // A plain-object iterator over a snapshot `items` list (iterator objects
    // carry `next` and `[Symbol.iterator]`, so spread / for-of / Array.from work).
    static listIterator(items: any): any {
        let idx = 0;
        const it: any = {
            next: function (): any {
                if (idx < items.length) {
                    const v = items[idx];
                    idx = idx + 1;
                    return { value: v, done: false };
                }
                return { value: undefined, done: true };
            },
        };
        it[Symbol.iterator] = function (): any {
            return it;
        };
        return it;
    }

    pairList(): any {
        const out: any = [];
        for (let i = 0; i < this.ks.length; i++) {
            out.push([this.ks[i], this.vs[i]]);
        }
        return out;
    }

    keys(): any {
        return URLSearchParams.listIterator(this.ks.slice());
    }

    values(): any {
        return URLSearchParams.listIterator(this.vs.slice());
    }

    entries(): any {
        return URLSearchParams.listIterator(this.pairList());
    }

    [Symbol.iterator](): any {
        return URLSearchParams.listIterator(this.pairList());
    }

    toString(): string {
        let out = "";
        for (let i = 0; i < this.ks.length; i++) {
            if (i > 0) {
                out = out + "&";
            }
            out = out + URLSearchParams.encode(this.ks[i]) + "=" + URLSearchParams.encode(this.vs[i]);
        }
        return out;
    }
}
