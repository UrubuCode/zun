// Nucleus `crypto` (Web Crypto basics, prelude class).
//
//   crypto.randomUUID()            RFC 4122 version-4 UUID string
//   crypto.getRandomValues(view)   fills an integer typed array in place and
//                                  returns that same view
//   crypto.subtle                  the `SubtleCrypto` object (SHA-256 digest)
//
// Every random byte comes from the operating system's CSPRNG through the
// `host` group's `cryptoRandomU64` native, which raises instead of degrading
// when the OS source is unavailable. Nothing here may ever be backed by
// `Math.random`.
//
// `crypto` is a namespace class (see `zun_natives::NAMESPACE_CLASSES`), so it
// is one value for typed code and for `globalThis.crypto`. Known differences
// from Node, where `crypto` is an instance of a `Crypto` class:
//   * the members are own properties of `crypto`, not inherited ones, and the
//     `Crypto` / `SubtleCrypto` / `CryptoKey` constructors are not globals;
//   * a member called without its receiver works instead of throwing;
//   * `subtle` implements `digest` for SHA-256 only; any other algorithm
//     rejects with `NotSupportedError`.

import { host as cryptoHost, string as cryptoString } from "zun:core";

function __zunCryptoHexDigit(d: u64): string {
    let digits = "0123456789abcdef";
    return cryptoString.substring(digits, d, d + 1);
}

function __zunCryptoHexByte(b: u64): string {
    return __zunCryptoHexDigit(b / 16) + __zunCryptoHexDigit(b % 16);
}

// One fresh random byte (0..255) from 64 OS random bits.
function __zunCryptoRandomByte(): u64 {
    let bits = cryptoHost.cryptoRandomU64() as u64;
    return (bits >> 56) & 255;
}

// Whether `data` is a typed array of an integer element kind (a subclass
// instance included). Float arrays, `DataView`, buffers and everything else
// are not.
function __zunCryptoIsIntegerView(data: any): boolean {
    if (data === null || data === undefined || typeof data !== "object") {
        return false;
    }
    return data instanceof Uint8Array || data instanceof Int8Array ||
        data instanceof Uint8ClampedArray || data instanceof Int16Array ||
        data instanceof Uint16Array || data instanceof Int32Array ||
        data instanceof Uint32Array || data instanceof BigInt64Array ||
        data instanceof BigUint64Array;
}

// The `SubtleCrypto` object behind `crypto.subtle`. `digest` implements
// SHA-256; every other algorithm rejects with `NotSupportedError`, as an
// unimplemented one must rather than answer something plausible.
class __ZunSubtleCrypto {
    get [Symbol.toStringTag](): string {
        return "SubtleCrypto";
    }

    digest(algorithm: any = undefined, data: any = undefined): any {
        let name: string = "";
        if (typeof algorithm === "string") {
            name = algorithm;
        } else if (algorithm !== null && algorithm !== undefined && typeof algorithm === "object") {
            name = String(algorithm.name);
        }
        name = name.toUpperCase();
        if (name !== "SHA-256") {
            return Promise.reject(new DOMException(
                "Unrecognized algorithm name",
                "NotSupportedError",
            ));
        }
        let bytes: any = data;
        if (data !== null && data !== undefined && data.buffer !== undefined) {
            bytes = new Uint8Array(data.buffer, data.byteOffset, data.byteLength);
        } else if (data !== null && data !== undefined && data.byteLength !== undefined) {
            bytes = new Uint8Array(data);
        } else {
            return Promise.reject(new TypeError(
                "Failed to execute 'digest' on 'SubtleCrypto': data is not a BufferSource",
            ));
        }
        return Promise.resolve(__zunSha256(bytes).buffer);
    }
}

// Holds the one `SubtleCrypto` object, away from `crypto` itself so the cache
// is not an own property of the namespace.
class __ZunCryptoState {
    static subtle: any = null;
}

class crypto {
    static get subtle(): any {
        if (__ZunCryptoState.subtle === null) {
            __ZunCryptoState.subtle = new __ZunSubtleCrypto();
        }
        return __ZunCryptoState.subtle;
    }

    static randomUUID(): string {
        let out = "";
        let i: u64 = 0;
        while (i < 16) {
            let b: u64 = __zunCryptoRandomByte();
            if (i == 6) {
                b = (b & 15) | 64;
            }
            if (i == 8) {
                b = (b & 63) | 128;
            }
            if (i == 4 || i == 6 || i == 8 || i == 10) {
                out = out + "-";
            }
            out = out + __zunCryptoHexByte(b);
            i = i + 1;
        }
        return out;
    }

    static getRandomValues(...args: any[]): any {
        if (args.length === 0) {
            throw new TypeError(
                "Failed to execute 'getRandomValues' on 'Crypto': 1 argument required, but only 0 present.",
            );
        }
        const data: any = args[0];
        if (!__zunCryptoIsIntegerView(data)) {
            throw new DOMException(
                "The data argument must be an integer-type TypedArray",
                "TypeMismatchError",
            );
        }
        const size: number = data.byteLength;
        if (size > 65536) {
            throw new DOMException(
                "The requested length exceeds 65,536 bytes",
                "QuotaExceededError",
            );
        }
        if (size === 0) {
            return data;
        }
        // Write through a byte view of exactly the receiver's window, so every
        // element kind (BigInt ones included) is filled with uniform bits and
        // nothing outside a `subarray` is touched.
        const bytes: Uint8Array = new Uint8Array(data.buffer, data.byteOffset, size);
        let n: u64 = bytes.length;
        let i: u64 = 0;
        while (i < n) {
            let bits = cryptoHost.cryptoRandomU64() as u64;
            let k: u64 = 0;
            while (k < 8) {
                if (i + k < n) {
                    bytes[i + k] = ((bits >> (k * 8)) & 255) as u8;
                }
                k = k + 1;
            }
            i = i + 8;
        }
        return data;
    }
}

// SHA-256 (FIPS 180-4) over a byte view. A hash, not a source of randomness:
// fully deterministic, so it belongs in the prelude. Verified against the
// published digest of "abc" (ba7816bf 8f01cfea 414140de 5dae2223 ...).
//
// The round constants are a function-local `const`: a prelude top-level binding
// is initialized *after* the user's code runs, so a module-level table would
// still be `undefined` at the first call.
function __zunSha256(bytes: any): any {
    const k: number[] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ];
    let h0: number = 0x6a09e667;
    let h1: number = 0xbb67ae85;
    let h2: number = 0x3c6ef372;
    let h3: number = 0xa54ff53a;
    let h4: number = 0x510e527f;
    let h5: number = 0x9b05688c;
    let h6: number = 0x1f83d9ab;
    let h7: number = 0x5be0cd19;
    const length: number = bytes.length;
    // Padding: 0x80, zeros, then the 64-bit big-endian bit length.
    const blocks: number = Math.ceil((length + 9) / 64);
    const total: number = blocks * 64;
    const data: any = new Uint8Array(total);
    for (let i = 0; i < length; i++) {
        data[i] = bytes[i];
    }
    data[length] = 0x80;
    const bitsHigh: number = Math.floor(length / 536870912);
    const bitsLow: number = (length * 8) >>> 0;
    data[total - 8] = (bitsHigh >>> 24) & 0xff;
    data[total - 7] = (bitsHigh >>> 16) & 0xff;
    data[total - 6] = (bitsHigh >>> 8) & 0xff;
    data[total - 5] = bitsHigh & 0xff;
    data[total - 4] = (bitsLow >>> 24) & 0xff;
    data[total - 3] = (bitsLow >>> 16) & 0xff;
    data[total - 2] = (bitsLow >>> 8) & 0xff;
    data[total - 1] = bitsLow & 0xff;
    const w: number[] = [];
    for (let i = 0; i < 64; i++) {
        w.push(0);
    }
    for (let block = 0; block < blocks; block++) {
        const base: number = block * 64;
        for (let i = 0; i < 16; i++) {
            const o: number = base + i * 4;
            w[i] = ((data[o] << 24) | (data[o + 1] << 16) | (data[o + 2] << 8) | data[o + 3]) >>> 0;
        }
        for (let i = 16; i < 64; i++) {
            const x: number = w[i - 15];
            const y: number = w[i - 2];
            const s0: number = (((x >>> 7) | (x << 25)) ^ ((x >>> 18) | (x << 14)) ^ (x >>> 3)) >>> 0;
            const s1: number = (((y >>> 17) | (y << 15)) ^ ((y >>> 19) | (y << 13)) ^ (y >>> 10)) >>> 0;
            // Four values below 2^32 sum exactly in a double, so one mask at the
            // end is enough.
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
        }
        let a: number = h0;
        let b: number = h1;
        let c: number = h2;
        let d: number = h3;
        let e: number = h4;
        let f: number = h5;
        let g: number = h6;
        let h: number = h7;
        for (let i = 0; i < 64; i++) {
            const bigS1: number = (((e >>> 6) | (e << 26)) ^ ((e >>> 11) | (e << 21)) ^ ((e >>> 25) | (e << 7))) >>> 0;
            const ch: number = ((e & f) ^ ((~e) & g)) >>> 0;
            const t1: number = (h + bigS1 + ch + k[i] + w[i]) >>> 0;
            const bigS0: number = (((a >>> 2) | (a << 30)) ^ ((a >>> 13) | (a << 19)) ^ ((a >>> 22) | (a << 10))) >>> 0;
            const maj: number = ((a & b) ^ (a & c) ^ (b & c)) >>> 0;
            const t2: number = (bigS0 + maj) >>> 0;
            h = g;
            g = f;
            f = e;
            e = (d + t1) >>> 0;
            d = c;
            c = b;
            b = a;
            a = (t1 + t2) >>> 0;
        }
        h0 = (h0 + a) >>> 0;
        h1 = (h1 + b) >>> 0;
        h2 = (h2 + c) >>> 0;
        h3 = (h3 + d) >>> 0;
        h4 = (h4 + e) >>> 0;
        h5 = (h5 + f) >>> 0;
        h6 = (h6 + g) >>> 0;
        h7 = (h7 + h) >>> 0;
    }
    const out: any = new Uint8Array(32);
    const words: number[] = [h0, h1, h2, h3, h4, h5, h6, h7];
    for (let i = 0; i < 8; i++) {
        const v: number = words[i];
        out[i * 4] = (v >>> 24) & 0xff;
        out[i * 4 + 1] = (v >>> 16) & 0xff;
        out[i * 4 + 2] = (v >>> 8) & 0xff;
        out[i * 4 + 3] = v & 0xff;
    }
    return out;
}
