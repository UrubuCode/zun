// Nucleus `crypto` (Web Crypto basics, prelude class).
//
//   crypto.randomUUID()            RFC 4122 version-4 UUID string
//   crypto.getRandomValues(arr)    fills a Uint8Array with random bytes
//
// Self-contained over the `host` group (`cryptoRandomU64`) and the `string`
// group of `zun:core`. Deferred: other typed-array views, `subtle`.

import { host as cryptoHost, string as cryptoString } from "zun:core";

class crypto {
    static hexDigit(d: u64): string {
        let digits = "0123456789abcdef";
        return cryptoString.substring(digits, d, d + 1);
    }

    static hexByte(b: u64): string {
        return crypto.hexDigit(b / 16) + crypto.hexDigit(b % 16);
    }

    // One fresh random byte (0..255) from 64 OS random bits.
    static randomByte(): u64 {
        let bits = cryptoHost.cryptoRandomU64() as u64;
        return (bits >> 56) & 255;
    }

    static randomUUID(): string {
        let out = "";
        let i: u64 = 0;
        while (i < 16) {
            let b: u64 = crypto.randomByte();
            if (i == 6) {
                b = (b & 15) | 64;
            }
            if (i == 8) {
                b = (b & 63) | 128;
            }
            if (i == 4 || i == 6 || i == 8 || i == 10) {
                out = out + "-";
            }
            out = out + crypto.hexByte(b);
            i = i + 1;
        }
        return out;
    }

    static getRandomValues(arr: Uint8Array): Uint8Array {
        let n: u64 = arr.length;
        let i: u64 = 0;
        while (i < n) {
            let bits = cryptoHost.cryptoRandomU64() as u64;
            let k: u64 = 0;
            while (k < 8) {
                if (i + k < n) {
                    arr[i + k] = ((bits >> (k * 8)) & 255) as u8;
                }
                k = k + 1;
            }
            i = i + 8;
        }
        return arr;
    }
}
