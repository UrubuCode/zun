// Managed error hierarchy.
//
// Construction follows JS: `new Error(message)` takes the message, and the
// name comes from the class. Zun builds an object by assigning one positional
// argument per declared field, so `name` cannot be a field — that would make
// the constructor `new Error(name, message)` and force every caller to repeat
// what the class already knows. It is a getter instead, which each subclass
// overrides and which virtual dispatch resolves to the right one.
//
// The trade is that `name` is read-only here, while JS allows `e.name = "..."`.
// That is a dynamic-path concern; typed code gets the correct name for free.
//
// Stack capture is runtime work: the `captureStackTrace` intrinsic walks the
// interpreter's live frames against the `.zm` sequence-point debug info (PLAN
// §3.1) and returns the frame lines. It is a *trailing field with a default
// initializer*, so it stays optional — `new Error(msg)` still takes the
// message alone — and is evaluated at the construction site, where the live
// frame chain is exactly the methods that led to the `new`. The public
// `.stack` getter renders the `name: message` header on top of it, so the
// header always reflects the concrete subclass and message.

import { captureStackTrace } from "zun:core";

class Error {
    message: string;
    stackFrames: string = captureStackTrace();
    // ECMAScript `new Error(message, { cause })`. The field is `any` so it can
    // carry a value of any type (via the frozen-layout `any`-field carrier) and
    // is absent (JS `undefined`) when no `cause` is supplied. The `(message,
    // options)` constructor shape does not fit Zun's one-arg-per-field model, so
    // Error-family construction is lowered specially in sema (`check.rs`): the
    // options object's `.cause` is read into this slot, or `undefined` when no
    // options object is given. This field has no default initializer because
    // every Error construction goes through that special lowering.
    cause: any;

    // Assignable `name` (`this.name = "X"` in subclass constructors): the
    // override wins over the class-provided default name.
    nameOverride: string = "";

    constructor(message: string, options?: any) {
        this.message = message;
        if (options !== undefined) {
            this.cause = options.cause;
        }
    }

    get errorName(): string {
        return "Error";
    }

    get name(): string {
        if (this.nameOverride != "") {
            return this.nameOverride;
        }
        return this.errorName;
    }

    set name(value: string) {
        this.nameOverride = value;
    }

    // JS omits the separator when either half is empty: `new Error()` prints
    // "Error", not "Error: ".
    toString(): string {
        if (this.message == "") {
            return this.name;
        }
        return this.name + ": " + this.message;
    }

    // `err.stack`: the JS-shaped header line followed by the captured frames.
    get stack(): string {
        if (this.stackFrames == "") {
            return this.toString();
        }
        return this.toString() + "\n" + this.stackFrames;
    }
}

class EvalError extends Error {
    get errorName(): string {
        return "EvalError";
    }
}

class RangeError extends Error {
    get errorName(): string {
        return "RangeError";
    }
}

class ReferenceError extends Error {
    get errorName(): string {
        return "ReferenceError";
    }
}

class SyntaxError extends Error {
    get errorName(): string {
        return "SyntaxError";
    }
}

class TypeError extends Error {
    get errorName(): string {
        return "TypeError";
    }
}

class URIError extends Error {
    get errorName(): string {
        return "URIError";
    }
}

// `AggregateError(errors, message)` — carries the list of errors that a
// combinator (e.g. `Promise.any`) collected. It does *not* extend `Error`:
// Zun builds an object field-by-field with inherited fields first, so an
// `extends Error` subclass would force `message` ahead of `errors` and could
// not express JS's `(errors, message)` order. Declared standalone, the field
// order is ours to choose, so the JS constructor shape is preserved. The cost
// is that `aggregate instanceof Error` is false; the shared surface
// (`name`/`toString`/`stack`) is duplicated here instead of inherited.
class AggregateError {
    errors: Array;
    message: string;
    stackFrames: string = captureStackTrace();

    get name(): string {
        return "AggregateError";
    }

    toString(): string {
        if (this.message == "") {
            return this.name;
        }
        return this.name + ": " + this.message;
    }

    get stack(): string {
        if (this.stackFrames == "") {
            return this.toString();
        }
        return this.toString() + "\n" + this.stackFrames;
    }
}
