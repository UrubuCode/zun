// Managed error hierarchy.
//
// Construction follows JS: `new Error(message)` takes the message, and the
// name comes from the class. Zun builds an object by assigning one positional
// argument per declared field, so `name` cannot be a field — that would make
// the constructor `new Error(name, message)` and force every caller to repeat
// what the class already knows. It is a getter instead, which each subclass
// overrides and which virtual dispatch resolves to the right one.
//
// The trade is that `name` is read-only here, while JS allows `e.name = "..."`.
// That is a dynamic-path concern; typed code gets the correct name for free.
//
// Stack capture is runtime work: the `captureStackTrace` intrinsic walks the
// interpreter's live frames against the `.zm` sequence-point debug info (PLAN
// §3.1) and returns the frame lines. It is a *trailing field with a default
// initializer*, so it stays optional — `new Error(msg)` still takes the
// message alone — and is evaluated at the construction site, where the live
// frame chain is exactly the methods that led to the `new`. The public
// `.stack` getter renders the `name: message` header on top of it, so the
// header always reflects the concrete subclass and message.

import { captureStackTrace } from "zun:core";

// ECMAScript `new Error(message)`: an absent (`undefined`) message installs no
// own property (it reads back as the empty string); anything else is ToString'd.
function __zunErrorMessage(message: any): string {
    if (message === undefined) {
        return "";
    }
    return `${message}`;
}

// True when `options` is an object that carries a `cause` key (own or inherited).
function __zunErrorHasCause(options: any): boolean {
    if (options === undefined || options === null) {
        return false;
    }
    if (typeof options !== "object") {
        return false;
    }
    return "cause" in options;
}

// The `name` an error inherits: the first own data `name` on its prototype chain
// (ECMAScript: `Error.prototype.name`, then `TypeError.prototype.name`, ...), so a
// `name` assigned on a class prototype, or a relinked chain, is what an instance
// reads. `fallback` is the class name, used when the chain carries none.
function __zunProtoName(self: any, fallback: string): string {
    let proto: any = Object.getPrototypeOf(self);
    let depth = 0;
    while (proto !== null && proto !== undefined && depth < 64) {
        const desc: any = Object.getOwnPropertyDescriptor(proto, "name");
        if (desc !== undefined && "value" in desc) {
            return String(desc.value);
        }
        proto = Object.getPrototypeOf(proto);
        depth = depth + 1;
    }
    return fallback;
}

class Error {
    message: string;
    stackFrames: string = captureStackTrace();
    // ECMAScript `new Error(message, { cause })`. The field is `any` so it can
    // carry a value of any type (via the frozen-layout `any`-field carrier) and
    // is absent (JS `undefined`) when no `cause` is supplied. The `(message,
    // options)` constructor shape does not fit Zun's one-arg-per-field model, so
    // Error-family construction is lowered specially in sema (`check.rs`): the
    // options object's `.cause` is read into this slot, or `undefined` when no
    // options object is given. This field has no default initializer because
    // every Error construction goes through that special lowering.
    cause: any;

    // Assignable `name` (`this.name = "X"` in subclass constructors): the
    // override wins over the class-provided default name.
    nameOverride: string = "";

    // True once an own `cause` property was installed (the options object had
    // the key); distinguishes `{ cause: undefined }` from no options at all.
    hasCause: boolean = false;

    // True once `name` was assigned a value (possibly the empty string); an
    // empty `nameOverride` alone cannot tell "assigned empty" from "never assigned".
    // Declared last: the native error allocators fill slots positionally.
    hasName: boolean = false;

    // True when `name` was assigned `undefined`: JS then reads `undefined`, and
    // `toString` substitutes "Error" - even on a subclass. A `string` getter cannot
    // answer `undefined`, so `name` itself reads as the class name.
    nameUndefined: boolean = false;

    constructor(message: string, options?: any) {
        this.message = message;
        if (__zunErrorHasCause(options)) {
            this.cause = options.cause;
            this.hasCause = true;
        }
    }

    get errorName(): string {
        return "Error";
    }

    get name(): string {
        if (this.hasName) {
            return this.nameOverride;
        }
        return __zunProtoName(this, this.errorName);
    }

    // Takes `any` because JS lets any value be assigned: `undefined` clears the
    // override (see `nameUndefined`), anything else is stringified.
    set name(value: any) {
        this.nameUndefined = value === undefined;
        if (value === undefined) {
            this.hasName = false;
            this.nameOverride = "";
            return;
        }
        this.nameOverride = typeof value === "string" ? value : String(value);
        this.hasName = true;
    }

    // JS omits the separator when either half is empty: `new Error()` prints
    // "Error", not "Error: ", and an explicitly empty name prints the message.
    toString(): string {
        const name = this.nameUndefined ? "Error" : this.name;
        if (this.message == "") {
            return name;
        }
        if (name == "") {
            return this.message;
        }
        return name + ": " + this.message;
    }

    // `err.stack`: the JS-shaped header line followed by the captured frames.
    get stack(): string {
        if (this.stackFrames == "") {
            return this.toString();
        }
        return this.toString() + "\n" + this.stackFrames;
    }
}

class EvalError extends Error {
    get errorName(): string {
        return "EvalError";
    }
}

class RangeError extends Error {
    get errorName(): string {
        return "RangeError";
    }
}

class ReferenceError extends Error {
    get errorName(): string {
        return "ReferenceError";
    }
}

class SyntaxError extends Error {
    get errorName(): string {
        return "SyntaxError";
    }
}

class TypeError extends Error {
    get errorName(): string {
        return "TypeError";
    }
}

class URIError extends Error {
    get errorName(): string {
        return "URIError";
    }
}

// `AggregateError(errors, message, options)` — carries the list of errors that
// a combinator (e.g. `Promise.any`) collected. It extends `Error`; construction
// runs its own constructor, so the (errors, message) argument order does not
// depend on field order.
class AggregateError extends Error {
    errors: any;

    constructor(errors: any, message?: string, options?: any) {
        super(message === undefined ? "" : message, options);
        if (errors === undefined || errors === null || typeof errors === "number" || typeof errors === "boolean") {
            throw new TypeError("object is not iterable");
        }
        this.errors = [...errors];
    }

    get errorName(): string {
        return "AggregateError";
    }
}
