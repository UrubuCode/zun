// Thin class wrapper over the Rust regex engine and managed heap floor.
import { regexp } from "zun:core";

class RegExp {
    isMatch(input: string): boolean { return regexp.isMatch(this, input); }
    test(input: string): boolean { return regexp.isMatch(this, input); }
    exec(input: string): array { return regexp.exec(this, input); }
    source(): string { return regexp.source(this); }
}
